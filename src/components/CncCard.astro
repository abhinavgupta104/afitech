---
/**
 * One replacement part in a grid: main photo, part number, price, minimum order.
 * The whole card is one link — the heading's anchor is stretched over it — so
 * a keyboard or screen reader meets a single, named target per part.
 */
import { Image } from 'astro:assets';
import { type CncPart, cncPhotos, inr } from '../data/cnc-parts';

export interface Props {
  part: CncPart;
  loading?: 'eager' | 'lazy';
}
const { part, loading = 'lazy' } = Astro.props;
const photo = cncPhotos(part.slug)[0];
---

<article class="cc">
  <div class="cc__media">
    {/* decorative here: the link text already names the part */}
    <Image src={photo} alt="" widths={[280, 440, 600]} sizes="(max-width: 520px) 88vw, (max-width: 980px) 44vw, 270px" loading={loading} />
  </div>
  <div class="cc__body">
    <p class="cc__sys">{part.partNumber ? `Replaces ${part.system}` : `For ${part.system}`}</p>
    <h3 class="cc__title">
      <a href={`/cnc-key-sheets/${part.slug}/`}>
        {part.partNumber ? <span class="cc__pn">{part.partNumber}</span> : null}
        <span class:list={['cc__kind', !part.partNumber && 'cc__kind--lead']}>{part.partNumber ? part.kind : `${part.system} ${part.kind}`}</span>
      </a>
    </h3>
    <p class="cc__sum">{part.summary}</p>
    <p class="cc__price">
      <span class="cc__amt">{part.priceFrom && <small>From </small>}{inr(part.price)}</span>
      <span class="cc__unit">per piece · MOQ {part.moq}</span>
    </p>
  </div>
</article>

<style>
  .cc {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: clip;
    transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease;
  }
  .cc:hover { border-color: var(--accent); box-shadow: var(--shadow-card); transform: translateY(-2px); }
  .cc:focus-within { border-color: var(--accent); }

  .cc__media {
    aspect-ratio: 1;
    background: #FFFFFF;
    border-bottom: 1px solid var(--line);
    position: relative;
  }
  /* pinned inside the square: photos are not all square, and an image in flow
     would size the box to its own proportions */
  .cc__media :global(img) { position: absolute; inset: 10px; width: calc(100% - 20px); height: calc(100% - 20px); object-fit: contain; }

  .cc__body { display: flex; flex-direction: column; gap: 6px; padding: 16px 18px 18px; }
  .cc__sys {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }
  .cc__title { font-size: inherit; line-height: 1.2; }
  .cc__title a { color: var(--ink); text-decoration: none; display: grid; gap: 2px; }
  /* stretched link: the whole card is the target */
  .cc__title a::after { content: ''; position: absolute; inset: 0; }
  .cc__title a:focus-visible { outline: none; }
  .cc:has(a:focus-visible) { outline: 3px solid var(--accent); outline-offset: 2px; }
  .cc__pn {
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -.01em;
    overflow-wrap: anywhere;
  }
  .cc__kind { font-family: var(--font-display); font-size: 18px; font-weight: 600; color: var(--ink-soft); }
  .cc__kind--lead { font-size: 20px; color: var(--ink); }
  .cc__sum { font-size: 14.5px; line-height: 1.5; color: var(--ink-soft); }

  .cc__price {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
  }
  .cc__amt { font-family: var(--font-display); font-size: 24px; font-weight: 700; letter-spacing: -.01em; color: var(--ink); }
  .cc__amt small { font-size: 14px; font-weight: 600; color: var(--muted); }
  .cc__unit { font-size: 13px; color: var(--muted); }

  /* phones: a compact row, so a list of thirty parts is not thirty screens tall */
  @media (max-width: 560px) {
    .cc { grid-template-rows: none; grid-template-columns: 116px minmax(0, 1fr); }
    .cc__media { border-bottom: 0; border-right: 1px solid var(--line); align-self: stretch; aspect-ratio: auto; min-height: 116px; }
    .cc__media :global(img) { inset: 6px; width: calc(100% - 12px); height: calc(100% - 12px); }
    .cc__body { padding: 12px 14px 14px; gap: 4px; }
    .cc__sum { display: none; }
    .cc__price { padding-top: 8px; }
    .cc__amt { font-size: 21px; }
  }

  @media (prefers-reduced-motion: reduce) { .cc:hover { transform: none; } }
</style>
