---
import { site } from '../data/site';

export interface Props {
  title?: string;
  body?: string;
}
const {
  title = 'Send a drawing and we will quote it',
  body = 'Most enquiries are answered within one working day. If the construction is still open, send what you have and we will tell you which one fits.',
} = Astro.props;

const waText = encodeURIComponent(
  'Hello AFI Technologies — I would like a quote for a membrane keypad.'
);
---

<section class="cta">
  <div class="wrap cta__grid">
    <div>
      <h2 class="cta__title">{title}</h2>
      <p class="cta__body">{body}</p>
    </div>

    <div class="cta__actions">
      <a class="btn btn--primary" href="/get-quote/">
        Request a quote
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2 8h11m-4.5-4.5L13 8l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a class="btn btn--ghost" href={`tel:${site.phoneHref}`}>Call {site.phone}</a>
      <a class="cta__wa" href={`https://wa.me/${site.whatsapp}?text=${waText}`} rel="noopener">
        or message us on WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  /* Full brand colour, not a pale tint of it. Near-black on orange measures
     5.3:1 — the same reason the buttons carry ink rather than white. */
  .cta {
    background: var(--accent);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .cta__grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }
  .cta__title { font-size: clamp(25px, 3.2vw, 34px); }
  .cta__body { margin-top: 12px; color: var(--ink-soft); max-width: 52ch; }

  .cta__actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .cta__actions .btn--ghost { background: var(--surface); }
  .cta__wa { font-size: 15px; }

  @media (max-width: 820px) {
    .cta__grid { grid-template-columns: 1fr; gap: 24px; }
  }
  .cta__title { color: var(--ink); }
  .cta__body  { color: rgba(36, 28, 22,.82); }
  .cta .btn--primary { background: var(--ink); color: #fff; border-color: var(--ink); }
  .cta .btn--primary:hover { background: #000; border-color: #000; }
  .cta .btn--ghost { color: var(--ink); border-color: rgba(36, 28, 22,.34); }
  .cta .btn--ghost:hover { background: rgba(255,255,255,.22); border-color: var(--ink); }
  .cta__wa { color: var(--ink); }
</style>
