---
/**
 * Artwork for one sheet of the exploded stack.
 *
 * Replaces the CSS-gradient sheets, which were schematically wrong in ways an
 * engineer would notice immediately:
 *   - the circuits were uniform graph paper. A real printed circuit has
 *     discrete contact pads at the key positions and traces routing to a tail.
 *   - there was no tail at all, which is the single most recognisable feature
 *     of a membrane switch.
 *   - the spacer had holes but no vent channels, so the stack would pump air
 *     and the keys would feel spongy.
 *   - nothing carried the switch geometry through the layers, so the key
 *     positions did not line up from sheet to sheet.
 *
 * Every layer shares one viewBox, so the six key positions, the display window
 * and the tail register exactly through the stack.
 *
 *   panel        x 20..280, y 12..168
 *   key centres  x 88 / 150 / 212,  y 62 / 122,  r 17
 *   window       x 60..240, y 24..46
 *   tail         x 128..172, running from the panel edge down to y 204
 *
 * Construction modelled is the non-tactile stack in products.ts: no domes,
 * a solid shorting pad on the upper circuit closing onto an interdigitated
 * pair on the lower.
 */
export interface Props {
  tone: 'overlay' | 'adhesive' | 'circuit' | 'spacer' | 'circuit-lower' | 'backing';
}
const { tone } = Astro.props;

const KEYS = [
  { x: 88, y: 62 }, { x: 150, y: 62 }, { x: 212, y: 62 },
  { x: 88, y: 122 }, { x: 150, y: 122 }, { x: 212, y: 122 },
];
---

<svg viewBox="0 0 300 210" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <defs>
    <pattern id={`hatch-${tone}`} width="11" height="11" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="11" stroke="#F08820" stroke-width="1.5" opacity=".55" />
    </pattern>
  </defs>

  {tone === 'overlay' && (
    <g>
      {/* printed polyester face — legends are on the underside, so the film
          reads as a single continuous surface with no cut key edges */}
      <rect x="20" y="12" width="260" height="156" rx="5" fill="#1F1F1F" stroke="#707070" stroke-width="1.2" />
      <rect x="26" y="18" width="248" height="144" rx="3" fill="none" stroke="#3A3A3A" stroke-width="1" />
      {/* display window left unprinted */}
      <rect x="60" y="24" width="180" height="22" rx="2" fill="#141414" stroke="#5a5a5a" stroke-width="1" />
      {KEYS.map((k) => (
        <g>
          <rect x={k.x - 21} y={k.y - 15} width="42" height="30" rx="4" fill="#2E2E2E" stroke="#707070" stroke-width="1" />
          <rect x={k.x - 9} y={k.y - 4} width="18" height="2.4" rx="1.2" fill="#ADADAD" />
        </g>
      ))}
    </g>
  )}

  {(tone === 'adhesive' || tone === 'backing') && (
    <g>
      {/* acrylic transfer adhesive, die-cut to the panel outline. The window
          is cut out; the key areas are not — the adhesive is continuous there */}
      <path
        d="M20 17a5 5 0 0 1 5-5h250a5 5 0 0 1 5 5v146a5 5 0 0 1-5 5H25a5 5 0 0 1-5-5Z M60 26a2 2 0 0 1 2-2h176a2 2 0 0 1 2 2v18a2 2 0 0 1-2 2H62a2 2 0 0 1-2-2Z"
        fill="#F08820"
        fill-opacity=".14"
        fill-rule="evenodd"
      />
      <path
        d="M20 17a5 5 0 0 1 5-5h250a5 5 0 0 1 5 5v146a5 5 0 0 1-5 5H25a5 5 0 0 1-5-5Z M60 26a2 2 0 0 1 2-2h176a2 2 0 0 1 2 2v18a2 2 0 0 1-2 2H62a2 2 0 0 1-2-2Z"
        fill={`url(#hatch-${tone})`}
        fill-rule="evenodd"
      />
      <rect x="20" y="12" width="260" height="156" rx="5" fill="none" stroke="#F08820" stroke-width="1.3" opacity=".75" />
      <rect x="60" y="24" width="180" height="22" rx="2" fill="none" stroke="#F08820" stroke-width="1" opacity=".6" />
      {tone === 'backing' && (
        <rect x="128" y="168" width="44" height="12" fill={`url(#hatch-${tone})`} opacity=".8" />
      )}
    </g>
  )}

  {tone === 'circuit' && (
    <g>
      {/* upper circuit: solid silver shorting pads that bridge the pair below */}
      <rect x="20" y="12" width="260" height="156" rx="5" fill="#1F1F1F" fill-opacity=".9" stroke="#838383" stroke-width="1.1" />
      {KEYS.map((k) => (
        <g>
          <circle cx={k.x} cy={k.y} r="17" fill="#DEDEDC" />
          <circle cx={k.x} cy={k.y} r="17" fill="none" stroke="#989898" stroke-width="1" />
        </g>
      ))}
      {/* row buses running to the tail exit */}
      <path d="M88 79v14h124V79" stroke="#D1D1D1" stroke-width="2.4" />
      <path d="M88 139v10h124v-10" stroke="#D1D1D1" stroke-width="2.4" />
      <path d="M150 93v46" stroke="#D1D1D1" stroke-width="2.4" />
      <path d="M150 149v19" stroke="#D1D1D1" stroke-width="2.6" />
    </g>
  )}

  {tone === 'circuit-lower' && (
    <g>
      {/* lower circuit: interdigitated pairs, plus the tail that leaves the
          stack and terminates in the connector */}
      <rect x="20" y="12" width="260" height="156" rx="5" fill="#1F1F1F" fill-opacity=".94" stroke="#838383" stroke-width="1.1" />
      {KEYS.map((k) => (
        <g>
          <circle cx={k.x} cy={k.y} r="17" fill="#141414" stroke="#707070" stroke-width=".8" />
          {[-10, -4, 2, 8].map((o) => (
            <rect x={k.x + o} y={k.y - 11} width="2.6" height="22" rx="1.3" fill="#DEDEDC" />
          ))}
          <rect x={k.x - 13.5} y={k.y - 11} width="2.6" height="22" rx="1.3" fill="#989898" />
        </g>
      ))}
      <path d="M88 84h124M88 144h124" stroke="#D1D1D1" stroke-width="2.2" />
      <path d="M150 84v60" stroke="#D1D1D1" stroke-width="2.2" />
      {/* the tail */}
      <path d="M128 168h44v30h-44z" fill="#1F1F1F" stroke="#838383" stroke-width="1.1" />
      {[134, 141, 148, 155, 162].map((x) => (
        <rect x={x} y="168" width="2.6" height="24" fill="#D1D1D1" />
      ))}
      <rect x="126" y="192" width="48" height="12" rx="2" fill="#141414" stroke="#989898" stroke-width="1.2" />
    </g>
  )}

  {tone === 'spacer' && (
    <g>
      {/* die-cut spacer. The hole under each key is the switch; the slots are
          vent channels — without them the stack pumps air and keys feel dead */}
      <path
        d={`M20 17a5 5 0 0 1 5-5h250a5 5 0 0 1 5 5v146a5 5 0 0 1-5 5H25a5 5 0 0 1-5-5Z ${KEYS.map((k) => `M${k.x - 17} ${k.y}a17 17 0 1 0 34 0a17 17 0 1 0-34 0Z`).join(' ')}`}
        fill="#D1D1D1"
        fill-opacity=".95"
        fill-rule="evenodd"
        stroke="#ADADAD"
        stroke-width="1.1"
      />
      {KEYS.map((k) => (
        <rect x={k.x - 1.6} y={k.y > 90 ? k.y + 17 : k.y - 20} width="3.2" height="3" fill="#ADADAD" />
      ))}
      <path d="M88 79h124M88 139h124" stroke="#ADADAD" stroke-width="1.6" stroke-linecap="round" />
    </g>
  )}
</svg>

<style>
  svg { width: 100%; height: 100%; display: block; overflow: visible; }
</style>
