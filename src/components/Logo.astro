---
/**
 * Brand lockup — the single place the identity is rendered.
 *
 * Built from the artwork the client supplied. Two variants are generated from
 * it in src/assets/brand/:
 *
 *   logo.webp        'TECHNOLOGIES' in the original brown, for light grounds
 *   logo-light.webp  the same wordmark in off-white, for dark grounds
 *
 * Both have the white JPEG background knocked out. The header and the footer
 * both sit on --ink, so both use the light variant; the plain one is here for
 * any light-ground placement that comes later.
 *
 * The logo sets the accent: orange #F88820 and green #00A050. The site around
 * it is black and white.
 */
import { Image } from 'astro:assets';
import { site } from '../data/site';
import logoLight from '../assets/brand/logo-light.webp';

export interface Props {
  /** 'header' sits on graphite and carries the descriptor line. */
  variant?: 'header' | 'footer';
}
const { variant = 'header' } = Astro.props;
---

<span class:list={['brand', `brand--${variant}`]}>
  <Image
    class="brand__img"
    src={logoLight}
    alt={`${site.name} logo`}
    width={454}
    height={240}
    loading="eager"
    densities={[1, 2]}
  />
</span>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    line-height: 1;
  }

  .brand :global(.brand__img) {
    width: auto;
    display: block;
  }
  .brand--header :global(.brand__img) { height: 50px; }
  .brand--footer :global(.brand__img) { height: 58px; }


  @media (max-width: 420px) {
    .brand--header :global(.brand__img) { height: 40px; }
  }
</style>
