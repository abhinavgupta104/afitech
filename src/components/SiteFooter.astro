---
/**
 * Site footer.
 *
 * The old footer carried the wrong company name ("AFI TECHNOLOGY"), a partial
 * address, unlinked contact details and social labels at 2.06:1 contrast.
 *
 * This one leads with the two things a B2B buyer checks before enquiring —
 * where you actually are, and whether the certification is real — then gives
 * the site map the old one never had.
 */
import { site, footerNav } from '../data/site';
import Logo from './Logo.astro';

const a = site.address;
const cert = site.certification;
const waText = encodeURIComponent(
  'Hello AFI Technologies — I would like a quote for a membrane keypad.'
);
const year = new Date().getFullYear();
const expires = new Date(cert.expires).toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric',
});
const mapQuery = encodeURIComponent(
  `${a.line1}, ${a.line2}, ${a.locality}, ${a.city} ${a.postalCode}, ${a.region}`
);
---

<footer class="ftr">
  <div class="wrap">
    <div class="ftr__top">
      <div class="ftr__org">
        <Logo variant="footer" />

        <address class="ftr__addr">
          {a.line1}<br />
          {a.line2}<br />
          {a.locality}, {a.city} – {a.postalCode}<br />
          {a.region}, {a.countryName}
        </address>
        <a class="ftr__map" href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`} rel="noopener">
          <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 1.5a4.5 4.5 0 0 1 4.5 4.5c0 3.2-4.5 8.5-4.5 8.5S3.5 9.2 3.5 6A4.5 4.5 0 0 1 8 1.5Z" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="8" cy="6" r="1.7" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
          View on the map
        </a>

        <ul class="ftr__contact">
          <li>
            <a href={`tel:${site.phoneHref}`}>
              <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M5.2 1.6 6.8 5 5.3 6.5a9.5 9.5 0 0 0 4.2 4.2L11 9.2l3.4 1.6v3A1.2 1.2 0 0 1 13.1 15 12.5 12.5 0 0 1 1 2.9 1.2 1.2 0 0 1 2.2 1.6Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
              {site.phone}
            </a>
          </li>
          <li>
            <a href={`mailto:${site.email}`}>
              <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="1" y="3" width="14" height="10" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="m1.6 4 6.4 4.6L14.4 4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
              {site.email}
            </a>
          </li>
          <li>
            <a href={`https://wa.me/${site.whatsapp}?text=${waText}`} rel="noopener">
              <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 1.6a6.4 6.4 0 0 0-5.5 9.6L1.6 14.4l3.3-.85A6.4 6.4 0 1 0 8 1.6Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M5.8 5.4c.2-.5.5-.4.7-.4h.5l.7 1.5-.6.6a4.3 4.3 0 0 0 2 2l.6-.7 1.5.7v.5c0 .3 0 .6-.5.8-1.2.5-3-.4-4-1.4s-1.9-2.8-1.4-3.6Z" fill="currentColor"/></svg>
              WhatsApp
            </a>
          </li>
          <li class="ftr__hours">{site.hours}</li>
        </ul>
      </div>

      <nav class="ftr__nav" aria-label="Footer">
        {footerNav.map((col) => (
          <div class="ftr__col">
            <h2 class="ftr__colhead">{col.title}</h2>
            <ul>
              {col.links.map((l) => (
                <li><a href={l.href}>{l.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    {/* The certificate as a plate rather than a run-on sentence — it is the
        strongest trust signal the company has. */}
    <a class="cert" href="/certificates/">
      <span class="cert__mark" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M12 2.5l7 3v6c0 4.3-2.9 8.2-7 10-4.1-1.8-7-5.7-7-10v-6l7-3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M8.5 11.8l2.4 2.4 4.6-4.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <span class="cert__body">
        <span class="cert__std">{cert.standard} certified</span>
        <span class="cert__meta">
          Certificate <span class="mono">{cert.number}</span> · {cert.body} under {cert.accreditation} accreditation · valid to {expires}
        </span>
      </span>
      <span class="cert__go" aria-hidden="true">View certificate →</span>
    </a>

    <div class="ftr__base">
      <p>© {year} {site.name}. All rights reserved.</p>
      <div class="ftr__baseend">
        <ul class="ftr__social">
          <li>
            <a href={site.social.youtube} rel="noopener" aria-label="AFI Technologies on YouTube">
              <svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M10.2 9.3v5.4l4.5-2.7-4.5-2.7Z" fill="currentColor"/></svg>
            </a>
          </li>
          <li>
            <a href={site.social.linkedin} rel="noopener" aria-label="AFI Technologies on LinkedIn">
              <svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="3" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M7.5 10.5V17M7.5 7.4v.1M11.2 17v-3.6a2.1 2.1 0 0 1 4.2 0V17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            </a>
          </li>
        </ul>
        <a class="ftr__top-link" href="#main">
          <svg width="12" height="12" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 13V3m0 0L3.5 7.5M8 3l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Back to top
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .ftr {
    background: var(--ink);
    background-image: var(--grain);
    color: #D1D1D1;            /* 9.6:1 on --ink */
    padding-block: clamp(52px, 7vw, 84px) 26px;
    font-size: 15.5px;
    border-top: 3px solid var(--accent);
  }
  .ftr a { color: #EDEDEB; text-decoration: none; }
  .ftr a:hover { color: #fff; text-decoration: underline; }

  .ftr__top {
    display: grid;
    grid-template-columns: minmax(270px, 1fr) 2fr;
    gap: clamp(32px, 5vw, 64px);
  }

  .ftr__addr { font-style: normal; margin-top: 16px; line-height: 1.65; }
  .ftr__map {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 10px;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent) !important;
    min-height: 26px;
  }
  .ftr__map svg { flex: none; }

  .ftr__contact {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  .ftr__contact a { display: inline-flex; align-items: center; gap: 9px; min-height: 28px; }
  .ftr__contact svg { flex: none; color: var(--accent); }
  .ftr__hours {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: #989898;            /* 5.6:1 on --ink */
    margin-top: 2px;
  }

  .ftr__nav { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 32px; }
  .ftr__colhead {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 14px;
  }
  .ftr__col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
  /* Text alone gives an 18px-tall target; WCAG 2.5.8 asks for 24px minimum. */
  .ftr__col a { font-size: 15px; display: inline-block; padding-block: 5px; }

  /* ───────── certificate plate ───────── */
  .cert {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 18px;
    margin-top: clamp(36px, 5vw, 56px);
    padding: 18px 20px;
    background: rgba(255, 255, 255, .035);
    border: 1px solid rgba(255, 255, 255, .13);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    text-decoration: none !important;
    transition: background-color .18s ease, border-color .18s ease;
  }
  .cert:hover { background: rgba(255, 255, 255, .06); border-color: rgba(240, 136, 32, .5); }
  .cert__mark { color: var(--accent); display: grid; place-items: center; }
  .cert__body { display: grid; gap: 4px; }
  .cert__std { font-family: var(--font-display); font-size: 19px; font-weight: 600; color: #fff; }
  .cert__meta { font-size: 13.6px; color: #D1D1D1; line-height: 1.5; }
  .cert__meta .mono { color: #fff; }
  .cert__go {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--accent);
    white-space: nowrap;
  }

  .ftr__base {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
    justify-content: space-between;
    align-items: center;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, .12);
    font-size: 14px;
    color: #989898;
  }
  .ftr__baseend { display: flex; align-items: center; gap: 22px; }
  .ftr__social { display: flex; gap: 10px; list-style: none; margin: 0; padding: 0; }
  .ftr__social a {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(255, 255, 255, .2);
    border-radius: var(--radius);
    color: #D1D1D1;
    transition: border-color .16s ease, color .16s ease, background-color .16s ease;
  }
  .ftr__social a:hover { border-color: var(--accent); color: #fff; background: rgba(240, 136, 32, .16); text-decoration: none; }
  .ftr__top-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: #D1D1D1 !important;
    min-height: 32px;
  }

  @media (max-width: 880px) {
    .ftr__top { grid-template-columns: 1fr; }
    .cert { grid-template-columns: auto minmax(0, 1fr); }
    .cert__go { grid-column: 2; }
  }
  @media (max-width: 520px) {
    .ftr__base { flex-direction: column; align-items: flex-start; }
    /* two columns of links, not three stacked lists a screen and a half long */
    .ftr__nav { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 20px; }
    .ftr__col a { font-size: 14.5px; }
  }
</style>
