---
/**
 * Site header.
 *
 * The old header was white text on #df6905 — 3.41:1, failing AA on every nav
 * item, and the mobile menu button was 2.54:1. Moving the bar to graphite and
 * keeping orange for the single CTA fixes both without losing the brand colour.
 *
 * It also restores the Products dropdown the old WordPress menu had. Losing it
 * in the rebuild meant the six product pages were reachable only by going to
 * /products/ first, which is a step backwards for a catalogue this small.
 */
import { site, nav } from '../data/site';
import { catalogue } from '../data/products';
import Logo from './Logo.astro';

const path = Astro.url.pathname;
/** A nav item is current when it is the page, or an ancestor of it. */
const isCurrent = (href: string) =>
  path === href || (href === '/products/' && catalogue.some((p) => path === `/${p.slug}/`));
---

<header class="hdr">
  <div class="wrap hdr__inner">
    <a class="brand-link" href="/" aria-label={`${site.name} — home`}>
      <Logo variant="header" />
    </a>

    <button class="hdr__toggle" type="button" id="nav-toggle" aria-expanded="false" aria-controls="primary-nav">
      <span class="hdr__toggle-bars" aria-hidden="true"><span></span><span></span><span></span></span>
      Menu
    </button>

    <nav class="hdr__nav" id="primary-nav" aria-label="Primary">
      <ul class="hdr__list">
        {nav.map((item) => (
          item.href === '/products/' ? (
            <li class="hdr__item hdr__item--menu">
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
                <svg class="hdr__caret" width="9" height="6" viewBox="0 0 9 6" aria-hidden="true" focusable="false"><path d="M1 1l3.5 3.5L8 1" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
              <div class="hdr__drop">
                <ul>
                  {catalogue.map((p) => (
                    <li>
                      <a href={`/${p.slug}/`} aria-current={path === `/${p.slug}/` ? 'page' : undefined}>
                        <span class="hdr__dropname">{p.shortName}</span>
                        <span class="hdr__dropsum">{p.summary}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ) : (
            <li class="hdr__item">
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
            </li>
          )
        ))}
      </ul>

      <div class="hdr__end">
        <a class="hdr__tel" href={`tel:${site.phoneHref}`}>
          <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M5.2 1.6 6.8 5 5.3 6.5a9.5 9.5 0 0 0 4.2 4.2L11 9.2l3.4 1.6v3A1.2 1.2 0 0 1 13.1 15 12.5 12.5 0 0 1 1 2.9 1.2 1.2 0 0 1 2.2 1.6Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
          {site.phone}
        </a>
        <a class="btn btn--primary hdr__cta" href="/get-quote/">Request a quote</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--ink);
    border-bottom: 1px solid rgba(255, 255, 255, .1);
  }
  /* Depth that arrives once the page has moved under the bar. Opacity only. */
  .hdr::after {
    content: '';
    position: absolute;
    inset: auto 0 -1px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent) 22%, var(--accent) 78%, transparent);
    opacity: 0;
    pointer-events: none;
  }
  .hdr__inner {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 72px;
    flex-wrap: wrap;
  }

  .brand-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: #fff;
    margin-right: auto;
    padding-block: 12px;
  }

  .hdr__nav { display: flex; align-items: center; gap: 26px; }
  .hdr__list { display: flex; align-items: center; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .hdr__item { position: relative; }

  .hdr__item > a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #EDEEEF;          /* 13.6:1 on --ink */
    text-decoration: none;
    font-size: 15.5px;
    font-weight: 500;
    padding: 9px 12px;
    border-radius: var(--radius);
    white-space: nowrap;
    position: relative;
  }
  .hdr__item > a::after {
    content: '';
    position: absolute;
    left: 12px; right: 12px; bottom: 3px;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform .18s ease;
  }
  .hdr__item > a:hover::after,
  .hdr__item:focus-within > a::after { transform: scaleX(1); }
  .hdr__item > a[aria-current='page'] { color: #fff; }
  .hdr__item > a[aria-current='page']::after { transform: scaleX(1); }
  .hdr__caret { flex: none; opacity: .65; transition: transform .18s ease; }

  /* ── products dropdown ── */
  .hdr__drop {
    position: absolute;
    top: calc(100% + 10px);
    left: -8px;
    width: 460px;
    background: #1B2027;
    border: 1px solid rgba(255, 255, 255, .14);
    border-radius: var(--radius);
    box-shadow: 0 26px 48px -24px rgba(0, 0, 0, .9);
    padding: 8px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity .16s ease, transform .16s ease, visibility .16s;
  }
  .hdr__item--menu:hover .hdr__drop,
  .hdr__item--menu:focus-within .hdr__drop {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .hdr__item--menu:hover .hdr__caret,
  .hdr__item--menu:focus-within .hdr__caret { transform: rotate(180deg); }
  /* keeps the pointer from falling through the gap on the way down */
  .hdr__item--menu::before {
    content: '';
    position: absolute;
    top: 100%; left: 0; right: 0;
    height: 12px;
  }
  .hdr__drop ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 2px; }
  .hdr__drop a {
    display: grid;
    gap: 3px;
    padding: 10px 12px;
    border-radius: var(--radius);
    text-decoration: none;
    transition: background-color .14s ease;
  }
  .hdr__drop a:hover { background: rgba(255, 255, 255, .06); }
  .hdr__drop a[aria-current='page'] { background: rgba(228, 102, 26, .16); }
  .hdr__dropname { font-size: 14.5px; font-weight: 600; color: #fff; }
  .hdr__dropsum {
    font-size: 12.4px;
    line-height: 1.4;
    color: #A8AFB6;          /* 6.6:1 on the panel */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hdr__end { display: flex; align-items: center; gap: 18px; }
  .hdr__tel {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #C8CDD2;          /* 9.4:1 on --ink */
    text-decoration: none;
    font-size: 14.5px;
    font-weight: 500;
    white-space: nowrap;
    padding-block: 6px;
  }
  .hdr__tel svg { color: var(--accent); flex: none; }
  .hdr__tel:hover { color: #fff; }
  .hdr__cta { min-height: 44px; padding: 10px 20px; font-size: 15px; }

  .hdr__toggle {
    display: none;
    align-items: center;
    gap: 9px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, .3);
    border-radius: var(--radius);
    color: #fff;             /* 13.9:1 on --ink, vs 2.54:1 on the old site */
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    min-height: 44px;
    padding: 8px 16px;
    cursor: pointer;
  }
  .hdr__toggle-bars { display: grid; gap: 4px; }
  .hdr__toggle-bars span { display: block; width: 18px; height: 2px; background: currentColor; border-radius: 1px; }

  @media (max-width: 1140px) {
    .hdr__tel { display: none; }
  }

  @media (max-width: 940px) {
    .hdr__toggle { display: inline-flex; }
    .hdr__nav {
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-bottom: 16px;
    }
    .hdr__nav[hidden] { display: none; }
    .hdr__list { flex-direction: column; align-items: stretch; gap: 0; }
    .hdr__item > a {
      display: flex;
      justify-content: space-between;
      padding: 14px 2px;
      border-radius: 0;
      border-bottom: 1px solid rgba(255, 255, 255, .1);
    }
    .hdr__item > a::after { display: none; }
    .hdr__caret { display: none; }

    /* no hover on touch: the products list is simply always open, indented */
    .hdr__drop {
      position: static;
      width: auto;
      opacity: 1;
      visibility: visible;
      transform: none;
      background: transparent;
      border: 0;
      box-shadow: none;
      padding: 4px 0 4px 14px;
      border-left: 2px solid rgba(228, 102, 26, .5);
      margin: 8px 0 8px 2px;
    }
    .hdr__drop ul { grid-template-columns: 1fr; gap: 0; }
    .hdr__drop a { padding: 9px 8px; }
    .hdr__dropsum { display: none; }
    .hdr__end { flex-direction: column; align-items: stretch; gap: 12px; margin-top: 16px; }
    .hdr__tel { display: inline-flex; justify-content: center; min-height: 44px; border: 1px solid rgba(255,255,255,.22); border-radius: var(--radius); }
    .hdr__cta { width: 100%; }
  }

  /* the accent hairline fades in once the page scrolls under the bar */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hdr::after {
        animation: hdr-edge linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 140px;
      }
      @keyframes hdr-edge { to { opacity: .85; } }
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('primary-nav');

  if (toggle && panel) {
    const mq = window.matchMedia('(max-width: 940px)');

    // Only hide the nav where the toggle is actually shown, so the desktop
    // layout never depends on JavaScript having run.
    const sync = () => {
      if (mq.matches) {
        panel.hidden = toggle.getAttribute('aria-expanded') !== 'true';
      } else {
        panel.hidden = false;
      }
    };

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      sync();
    });

    mq.addEventListener('change', sync);
    sync();
  }
</script>
