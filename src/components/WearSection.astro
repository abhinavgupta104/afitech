---
/**
 * Chapter three's proof, drawn the way an engineer would draw it: a plan view
 * of one key with a section line A–A through it, and Section A–A below showing
 * the layer stack edge-on.
 *
 * The chapter's whole claim is "it is where the ink is". The previous version
 * showed two near-identical dark boxes reading START and left that claim to a
 * caption. Here the difference is the drawing itself:
 *
 *   printed label       ink ON TOP of the film   → the pad scrapes it off
 *   sub-surface overlay ink UNDER the film       → the pad only scuffs the film
 *
 * On scroll an abrasion pad sweeps across the top surface of both. At rest —
 * no scroll timelines, or reduced motion — the drawing shows the outcome
 * instead, so the argument still reads without the motion.
 *
 * The choreography lives in this component, not the page: Astro scopes styles
 * per component, and rules written in index.astro cannot reach these elements.
 * Layer thicknesses are exaggerated for legibility, and the drawing says so.
 */
export interface Props {
  kind: 'label' | 'overlay';
  fig: string;
  title: string;
  note: string;
}
const { kind, fig, title, note } = Astro.props;
const isLabel = kind === 'label';

// Section A–A layer bands, top to bottom. The two constructions differ only in
// whether the ink sits above or below the film.
const layers = isLabel
  ? [
      { key: 'ink', y: 172, h: 8, label: 'INK' },
      { key: 'film', y: 180, h: 24, label: 'FILM' },
      { key: 'adh', y: 204, h: 12, label: 'ADHESIVE' },
      { key: 'panel', y: 216, h: 30, label: 'PANEL' },
    ]
  : [
      { key: 'film', y: 172, h: 24, label: 'FILM' },
      { key: 'ink', y: 196, h: 8, label: 'INK' },
      { key: 'adh', y: 204, h: 12, label: 'ADHESIVE' },
      { key: 'panel', y: 216, h: 30, label: 'PANEL' },
    ];
const labelY = [176, 196, 214, 236];
const fillFor = (k: string) =>
  k === 'ink' ? '#9A5207'
  : k === 'film' ? '#F7F7F6'
  : k === 'adh' ? `url(#adh-${kind})`
  : `url(#pnl-${kind})`;
---

<figure class={`wsec wsec--${kind}`}>
  <div class="wsec__head">
    <span class="wsec__fig">{fig}</span>
    <span class="wsec__title">{title}</span>
  </div>

  <svg class="wsec__svg" viewBox="0 0 380 262" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <defs>
      <pattern id={`adh-${kind}`} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect width="6" height="6" fill="#F0F0EE" />
        <line x1="0" y1="0" x2="0" y2="6" stroke="#F08820" stroke-width="1.4" />
      </pattern>
      <pattern id={`pnl-${kind}`} width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)">
        <rect width="8" height="8" fill="#DEDEDC" />
        <line x1="0" y1="0" x2="0" y2="8" stroke="#838383" stroke-width="1" />
      </pattern>
    </defs>

    <!-- ── plan view ── -->
    <text class="t-cap" x="20" y="16">PLAN</text>
    <rect x="120" y="24" width="140" height="72" rx="8" fill="#1F1F1F" />
    <text class:list={['legend', isLabel && 'legend--wears']} x="190" y="68" text-anchor="middle">START</text>

    <!-- section line A–A through the key -->
    <line x1="98" y1="86" x2="282" y2="86" stroke="#F08820" stroke-width="1.3" stroke-dasharray="14 4 3 4" />
    <path d="M98 86v8M282 86v8" stroke="#F08820" stroke-width="1.3" />
    <text class="t-sec" x="92" y="90" text-anchor="end">A</text>
    <text class="t-sec" x="288" y="90">A</text>

    <!-- ── section A–A ── -->
    <text class="t-cap" x="20" y="126">SECTION A–A</text>
    <text class="t-cap t-cap--dim" x="276" y="126" text-anchor="end">NOT TO SCALE</text>
    <line x1="20" y1="134" x2="276" y2="134" stroke="#DEDEDC" stroke-width="1" />

    {layers.map((l) => (
      <rect x="20" y={l.y} width="256" height={l.h} fill={fillFor(l.key)}
        stroke={l.key === 'film' ? '#989898' : 'none'} stroke-width="1" />
    ))}

    {isLabel ? (
      <g>
        {/* the pad takes the ink with it: surface cleared behind the pad */}
        <rect class="erase" x="20" y="171" width="256" height="10" fill="#FFFFFF" />
        <rect x="20" y="172" width="256" height="8" fill="none" stroke="#9A5207" stroke-width="1" stroke-dasharray="4 3" opacity=".55" />
        {/* own group, so :nth-of-type counts only the fragments */}
        <g>
          {[[58, 160, 5, 3], [102, 156, 3, 3], [146, 162, 6, 2], [188, 155, 3, 4], [232, 161, 5, 3]].map(([x, y, w, h]) => (
            <rect class="debris" x={x} y={y} width={w} height={h} fill="#9A5207" />
          ))}
        </g>
      </g>
    ) : (
      <g>
        {/* the film takes the wear; the ink below it is untouched */}
        {[[48, 22], [96, 14], [150, 26], [204, 16], [244, 20]].map(([x, w]) => (
          <line class="scratch" x1={x} y1="174.5" x2={x + w} y2="173" stroke="#838383" stroke-width="1.3" stroke-linecap="round" />
        ))}
      </g>
    )}

    <!-- abrasion pad -->
    <g class="pad">
      <path d="M8 152h8M4 158h12M8 164h8" stroke="#989898" stroke-width="1.4" stroke-linecap="round" />
      <rect x="20" y="146" width="50" height="24" rx="5" fill="#D1D1D1" stroke="#707070" stroke-width="1.2" />
      <path d="M28 150l34 16M38 150l24 11M48 150l14 6" stroke="#838383" stroke-width="1" />
    </g>

    {/* leaders to the layer labels */}
    {layers.map((l, i) => (
      <g>
        <path d={`M276 ${l.y + l.h / 2} L288 ${labelY[i] - 3} L292 ${labelY[i] - 3}`} stroke="#989898" stroke-width="1" />
        <text class:list={['t-lead', l.key === 'ink' && 't-lead--ink']} x="296" y={labelY[i]}>{l.label}</text>
      </g>
    ))}
  </svg>

  <p class="wsec__chip">
    {isLabel ? (
      <>
        {/* transitional only: shown while the pad is still crossing. Hidden
            from assistive tech, which would otherwise announce "intact" and
            "worn away" back to back — opacity does not hide from a reader. */}
        <span class="chip chip--ok chip--before" aria-hidden="true">Legend intact</span>
        <span class="chip chip--bad chip--after">Legend worn away</span>
      </>
    ) : (
      <span class="chip chip--ok">Legend intact</span>
    )}
  </p>
  <figcaption class="wsec__note">{note}</figcaption>
</figure>

<style>
  .wsec {
    margin: 0;
    background: #FFFFFF;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(18px, 2.4vw, 26px);
    display: grid;
    gap: 14px;
    view-timeline-name: --wear;
    view-timeline-axis: block;
  }
  .wsec__head { display: grid; gap: 4px; }
  .wsec__fig {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }
  .wsec__title {
    font-family: var(--font-display);
    font-size: clamp(21px, 2.2vw, 26px);
    font-weight: 600;
    letter-spacing: -.012em;
    color: var(--ink);
  }
  .wsec__svg { width: 100%; height: auto; display: block; overflow: visible; }

  .t-cap { font-family: var(--font-mono); font-size: 10px; letter-spacing: .12em; fill: #707070; }
  .t-cap--dim { fill: #989898; }
  .t-sec { font-family: var(--font-mono); font-size: 12px; font-weight: 600; fill: #9A5207; }
  .t-lead { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .08em; fill: #5a5a5a; }
  .t-lead--ink { fill: #9A5207; font-weight: 600; }
  .legend {
    font-family: var(--font-display);
    font-size: 23px;
    font-weight: 700;
    letter-spacing: .1em;
    fill: #F7F7F6;
  }

  /* At rest the drawing shows the outcome: the label's ink already gone. */
  .legend--wears { opacity: .16; }
  .erase { transform-box: fill-box; transform-origin: 0 50%; transform: scaleX(1); }
  .debris { opacity: .5; }
  .scratch { opacity: .75; }
  .pad { transform: translateX(206px); }

  .wsec__chip { display: grid; justify-items: start; margin: 0; }
  .chip {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: .1em;
    text-transform: uppercase;
    padding: 6px 11px;
    border-radius: 2px;
  }
  .chip::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: currentColor; flex: none; }
  .chip--ok  { color: #08703B; background: #CDEFD8; }   /* 4.9:1 */
  .chip--bad { color: #A33A17; background: #FADBCB; }   /* 5.6:1 */
  .chip--before { opacity: 0; }

  .wsec__note { font-size: 15px; color: var(--ink-soft); line-height: 1.55; }

  /* At phone width the 380-unit drawing renders ~310px wide, which took the
     drawing labels down to 8px. Sized up in drawing units so they land ~10px. */
  @media (max-width: 560px) {
    .t-cap { font-size: 13px; }
    .t-lead { font-size: 12.5px; }
    .t-sec { font-size: 14px; }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .pad {
        animation: wsec-pad var(--ease-in-out) both;
        animation-timeline: --wear;
        animation-range: cover 24% cover 60%;
        will-change: transform;
      }
      @keyframes wsec-pad { from { transform: translateX(0); } to { transform: translateX(206px); } }

      .erase {
        animation: wsec-erase var(--ease-in-out) both;
        animation-timeline: --wear;
        animation-range: cover 24% cover 60%;
      }
      @keyframes wsec-erase { from { transform: scaleX(0); } to { transform: scaleX(1); } }

      .legend--wears {
        animation: wsec-fade linear both;
        animation-timeline: --wear;
        animation-range: cover 30% cover 60%;
      }
      @keyframes wsec-fade {
        from { opacity: 1; filter: blur(0); }
        to   { opacity: .16; filter: blur(1.2px); }
      }

      .debris, .scratch {
        animation: wsec-mark linear both;
        animation-timeline: --wear;
      }
      @keyframes wsec-mark { from { opacity: 0; } to { opacity: var(--o, .6); } }
      .debris { --o: .5; }
      .scratch { --o: .75; }
      .debris:nth-of-type(1), .scratch:nth-of-type(1) { animation-range: cover 28% cover 34%; }
      .debris:nth-of-type(2), .scratch:nth-of-type(2) { animation-range: cover 34% cover 40%; }
      .debris:nth-of-type(3), .scratch:nth-of-type(3) { animation-range: cover 41% cover 47%; }
      .debris:nth-of-type(4), .scratch:nth-of-type(4) { animation-range: cover 47% cover 53%; }
      .debris:nth-of-type(5), .scratch:nth-of-type(5) { animation-range: cover 53% cover 59%; }

      .chip--before {
        animation: wsec-out linear both;
        animation-timeline: --wear;
        animation-range: cover 55% cover 61%;
      }
      @keyframes wsec-out { from { opacity: 1; } to { opacity: 0; } }
      .chip--after {
        animation: wsec-in linear both;
        animation-timeline: --wear;
        animation-range: cover 55% cover 61%;
      }
      @keyframes wsec-in { from { opacity: 0; } to { opacity: 1; } }
    }
  }
</style>
