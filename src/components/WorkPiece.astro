---
/**
 * The workpiece — a single panel that is manufactured in front of the reader
 * as chapter five scrolls.
 *
 * Each <g class="wp"> is one step of the process, and they are additive: the
 * drawing arrives first, then the printed face, then the ink, the circuit, the
 * cut edge, the laminated thickness and finally the tail and the test stamp.
 * The scroll ranges that reveal them live in index.astro, keyed to the same
 * --proc timeline that drives the card track, so the part and the cards stay
 * in step.
 *
 * Geometry is the same panel used by the exploded stack in chapter two and the
 * step drawings, so all three read as the same product:
 *   panel        x 20..280, y 12..168
 *   key centres  x 88 / 150 / 212,  y 62 / 122
 *
 * At rest — no scroll timelines, reduced motion, or narrow screens — every
 * stage is visible, so this renders as a finished panel rather than an empty
 * frame.
 */
const KEYS = [
  { x: 88, y: 62, c: '#C7502A' }, { x: 150, y: 62, c: '#2F6E8F' }, { x: 212, y: 62, c: '#3F7A4A' },
  { x: 88, y: 122, c: '#2F6E8F' }, { x: 150, y: 122, c: '#6B5E8C' }, { x: 212, y: 122, c: '#C7502A' },
];
---

<svg viewBox="0 0 300 232" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <!-- 1 · the drawing. Stays as a faint underlay for the rest of the build. -->
  <g class="wp wp--1">
    <rect x="20" y="12" width="260" height="156" rx="5" fill="none" stroke="#7E8A94" stroke-width="1.2" stroke-dasharray="6 4" />
    {KEYS.map((k) => (
      <rect x={k.x - 21} y={k.y - 15} width="42" height="30" rx="4" fill="none" stroke="#5C6871" stroke-width="1" stroke-dasharray="4 3" />
    ))}
    <g stroke="#E4661A" stroke-width="1">
      <line x1="20" y1="186" x2="280" y2="186" />
      <path d="M20 182v8M280 182v8" />
    </g>
    <text x="150" y="199" fill="#E4661A" font-family="monospace" font-size="9" text-anchor="middle">260.0 ±0.15</text>
  </g>

  <!-- 2 · artwork: the printed face and its registration marks -->
  <g class="wp wp--2">
    <rect x="20" y="12" width="260" height="156" rx="5" fill="#23282E" stroke="#69737D" stroke-width="1.2" />
    <rect x="60" y="24" width="180" height="22" rx="2" fill="#0E1114" stroke="#59636D" stroke-width="1" />
    {[[30, 22], [270, 22], [30, 158], [270, 158]].map(([x, y]) => (
      <g stroke="#E4661A" stroke-width="1" opacity=".8">
        <circle cx={x} cy={y} r="4" fill="none" />
        <path d={`M${x - 7} ${y}h14M${x} ${y - 7}v14`} />
      </g>
    ))}
  </g>

  <!-- 3 · screen printing: colour goes down, one screen at a time -->
  <g class="wp wp--3">
    {KEYS.map((k) => (
      <g>
        <rect x={k.x - 21} y={k.y - 15} width="42" height="30" rx="4" fill={k.c} stroke="#8A939C" stroke-width=".8" />
        <rect x={k.x - 9} y={k.y - 3} width="18" height="2.2" rx="1.1" fill="#EDF1F4" opacity=".92" />
      </g>
    ))}
  </g>

  <!-- 4 · circuit printing, seen through the face -->
  <g class="wp wp--4" opacity=".62">
    {KEYS.map((k) => (
      <circle cx={k.x} cy={k.y} r="15" fill="none" stroke="#AFBCC7" stroke-width="1.4" stroke-dasharray="3 2.4" />
    ))}
    <path d="M88 79h124M88 139h124M150 79v60" stroke="#AFBCC7" stroke-width="1.4" />
  </g>

  <!-- 5 · die-cutting: the outline becomes a real cut edge -->
  <g class="wp wp--5">
    <rect x="20" y="12" width="260" height="156" rx="5" fill="none" stroke="#E4661A" stroke-width="2" />
  </g>

  <!-- 6 · lamination: the stack gains thickness -->
  <g class="wp wp--6">
    <path d="M22 170h256M24 174h252M27 178h246" stroke="#4A545C" stroke-width="2.4" stroke-linecap="round" />
    <path d="M22 170h256" stroke="#7E8A94" stroke-width="1" />
  </g>

  <!-- 7 · the tail goes on and the panel is tested -->
  <g class="wp wp--7">
    <path d="M130 178h40v34h-40z" fill="#1C2226" stroke="#7C858E" stroke-width="1.1" />
    {[135, 142, 149, 156, 163].map((x) => (
      <rect x={x} y="178" width="2.4" height="28" fill="#C3CBD3" />
    ))}
    <rect x="128" y="206" width="44" height="11" rx="2" fill="#0E1114" stroke="#8FA0AE" stroke-width="1.1" />
    <g transform="translate(236 176)">
      <circle cx="14" cy="14" r="13" fill="none" stroke="#5FAE63" stroke-width="1.8" />
      <path d="M7.5 14.5l4.5 4.5 9-9.5" fill="none" stroke="#5FAE63" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
    </g>
  </g>
</svg>

<style>
  svg { width: 100%; height: auto; display: block; overflow: visible; }

  /* The build choreography lives here, not in index.astro: Astro scopes styles
     per component, so `.wp` rules written in the page cannot reach these <g>
     elements and every stage rendered at once. The `--proc` timeline is named
     on the .proc section and resolves through the DOM, so referencing it from
     inside this component is fine. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      @media (min-width: 860px) {
        .wp {
          animation: wp-in var(--ease-out) both;
          animation-timeline: --proc;
          will-change: opacity, transform;
          transform-box: fill-box;
          transform-origin: 50% 50%;
        }
        @keyframes wp-in {
          from { opacity: 0; transform: translateY(7px) scale(.985); }
          to   { opacity: 1; transform: none; }
        }
        .wp--2 { animation-range: cover 32% cover 38%; }
        .wp--3 { animation-range: cover 39% cover 45%; }
        .wp--4 { animation-range: cover 46% cover 52%; }
        .wp--5 { animation-range: cover 53% cover 59%; }
        .wp--6 { animation-range: cover 60% cover 66%; }
        .wp--7 { animation-range: cover 67% cover 73%; }

        /* the drawing arrives first, then recedes under the printed face */
        .wp--1 {
          animation: wp-draw var(--ease-out) both;
          animation-timeline: --proc;
          animation-range: cover 25% cover 40%;
        }
        @keyframes wp-draw {
          0%   { opacity: 0; }
          40%  { opacity: 1; }
          100% { opacity: .22; }
        }
      }
    }
  }
</style>
