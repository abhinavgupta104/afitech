---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { site } from '../data/site';
---

<Base
  title={`Request a Quote | ${site.name}`}
  description="Request a quote for a custom membrane keypad, graphic overlay or PCB-backed panel. Send your drawing, key count and quantity — most enquiries answered within one working day."
  path="/get-quote/"
  crumbLabel="Request a quote"
>
  <PageHeader
    eyebrow="Enquiry"
    title="Request a quote"
    lede="Tell us what you need made. The more of the specification you can give us now, the closer the first number will be to the final one."
  />

  <section class="form">
    <div class="wrap">
      <QuoteForm />
    </div>
  </section>

  <section class="after">
    <div class="wrap">
      <h2 class="section-title">What happens next</h2>
      <ol class="after__list">
        <li>
          <span class="after__n mono">01</span>
          <div>
            <h3>We read the drawing</h3>
            <p>
              Before quoting we check emboss heights against key sizes, dome force against your
              duty cycle, and window ink density against the LED you have specified.
            </p>
          </div>
        </li>
        <li>
          <span class="after__n mono">02</span>
          <div>
            <h3>We come back with questions, or a price</h3>
            <p>
              If something in the drawing will cause trouble at tooling, you hear about it now
              rather than at first article. Most enquiries are answered within one working day.
            </p>
          </div>
        </li>
        <li>
          <span class="after__n mono">03</span>
          <div>
            <h3>Artwork approval, then first article</h3>
            <p>
              Artwork goes back and forth until you sign it off. Tooling follows approval, and a
              first article is produced for your inspection before the run.
            </p>
          </div>
        </li>
      </ol>

      <p class="after__alt">
        Prefer to talk it through first? Call <a href={`tel:${site.phoneHref}`}>{site.phone}</a>
        {' '}or <a href="/contact-us/">see all the ways to reach us</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .form { background: var(--surface); }

  .after__list { list-style: none; margin: 32px 0 0; padding: 0; display: grid; gap: 0; }
  .after__list li {
    display: grid; grid-template-columns: 52px 1fr; gap: 18px;
    padding: 22px 0; border-top: 1px solid var(--line);
  }
  .after__n { color: var(--accent-ink); font-size: 13px; padding-top: 6px; }
  .after__list h3 { font-size: clamp(19px, 2.2vw, 23px); }
  .after__list p { margin-top: 8px; color: var(--ink-soft); font-size: 16px; max-width: 66ch; }
  .after__alt { margin-top: 30px; font-size: 16.5px; }

  @media (max-width: 620px) {
    .after__list li { grid-template-columns: 1fr; gap: 4px; }
    .after__n { padding-top: 0; }
  }
</style>
