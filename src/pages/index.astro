---
/**
 * Homepage — a scroll-told story.
 *
 * Mechanics policy, which matters more here than anywhere else on the site:
 * the old homepage hid its whole body behind a "delay JS until interaction"
 * trick, so a visitor who did not move the mouse saw a blank page. Nothing
 * here repeats that.
 *
 *   - Every word and every figure is in the HTML and visible at rest.
 *   - The choreography is pure CSS scroll-driven animation. No JavaScript.
 *   - All of it sits inside @supports + prefers-reduced-motion: no-preference,
 *     so a browser without scroll timelines, or a reader who has asked for
 *     less motion, gets a plain, complete, fully readable page — not a broken
 *     one. The tall scroll stages only exist inside that block too, so they
 *     never become dead scroll space.
 *   - The 3D stack choreography is desktop-only; narrow screens get the same
 *     six layers as an ordinary list.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import LayerArt from '../components/LayerArt.astro';
import StepArt from '../components/StepArt.astro';
import WorkPiece from '../components/WorkPiece.astro';

import screenPrinting from '../assets/process/screen-printing.jpg';
import circuitPrint from '../assets/process/circuit-print.jpg';
import sealingTest from '../assets/process/sealing-test.jpg';

/* Three of the seven steps are covered by AFI's own factory footage. The
   other four get technical drawings rather than stock photography of somebody
   else's factory — including lamination, where the only candidate frame was
   actually a keypad being submerged for a water test. */
const stepPhotos: Record<string, ImageMetadata> = {
  'screen-printing': screenPrinting,
  'circuit-print': circuitPrint,
  'sealing-test': sealingTest,
};
import { site } from '../data/site';
import { industries } from '../data/industries';
import { opening, act1, stack, durability, choice, process, proof } from '../data/story';

import heroImage from '../assets/products/hero-alt.png';

const cert = site.certification;
const n = stack.layers.length;

const title = 'Membrane Keypad Manufacturer in Pune | AFI Technologies';
const description =
  'ISO 9001:2015 certified manufacturer of custom membrane keypads, graphic overlays and PCB-backed switch panels in Pune, India. See what is inside one, then send us a drawing.';
---

<Base title={title} description={description} path="/">
  <div class="rail" aria-hidden="true"><span class="rail__fill"></span></div>

  {/* ───────────────────────── opening ───────────────────────── */}
  <section class="open">
    <div class="open__field" aria-hidden="true"></div>
    <div class="wrap open__grid">
      <div class="open__copy">
        <p class="eyebrow">{opening.eyebrow}</p>
        <h1 class="open__h1">{opening.h1}</h1>
        <p class="open__lede">{opening.lede}</p>

        <div class="open__actions">
          <a class="btn btn--primary" href="/get-quote/">
            Send a drawing for a quote
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2 8h11m-4.5-4.5L13 8l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a class="btn btn--ghost" href="#inside">See what is inside one</a>
        </div>

        <p class="open__cue"><span class="open__cueline" aria-hidden="true"></span>{opening.scrollCue}</p>
      </div>

      <div class="open__media">
        <Image
          src={heroImage}
          alt="Three finished membrane keypads: a black industrial data-logger panel, a colour-coded weighing terminal keypad and a compact instrument keypad, each with its flexible tail connector"
          width={500}
          height={500}
          loading="eager"
          fetchpriority="high"
          sizes="(max-width: 900px) 84vw, 440px"
        />
      </div>
    </div>
  </section>

  {/* ───────────────────────── act one ───────────────────────── */}
  <section class="act1">
    <div class="wrap act1__grid">
      <p class="chapter"><span class="chapter__rule" aria-hidden="true"></span>{act1.chapter}<span class="chapter__ghost" aria-hidden="true">01</span></p>
      <div class="act1__body">
        <h2 class="act1__h2 reveal">{act1.heading}</h2>
        {act1.body.map((p) => <p class="act1__p reveal">{p}</p>)}
        <p class="act1__pull pull">
          {act1.pull.split(' ').map((w) => (
            <span class="pull__w"><span class="pull__i">{w}</span>{' '}</span>
          ))}
        </p>
      </div>
    </div>
  </section>

  {/* ──────────────────── act two — the stack ──────────────────── */}
  <section class="stack" id="inside">
    <div class="stack__stage">
      <div class="wrap stack__grid">
        <div class="stack__intro">
          <p class="chapter chapter--dark"><span class="chapter__rule" aria-hidden="true"></span>{stack.chapter}<span class="chapter__ghost" aria-hidden="true">02</span></p>
          <h2 class="stack__h2">{stack.heading}</h2>
          <p class="stack__body">{stack.body}</p>
        </div>

        <div class="stack__viz" aria-hidden="true">
          <div class="stack__scene">
            {stack.layers.map((l, i) => (
              <div class={`sheet sheet--${l.tone}`} style={`--i:${i}; --k:${n - 1 - i}`}>
                <LayerArt tone={l.tone} />
              </div>
            ))}
          </div>
        </div>

        <ol class="stack__list">
          {stack.layers.map((l, i) => (
            <li class="lyr" style={`--i:${i}; --k:${n - 1 - i}`}>
              <span class="lyr__n mono">{l.n}</span>
              <div class="lyr__text">
                <h3 class="lyr__name">{l.name}</h3>
                <p class="lyr__spec mono">{l.spec}</p>
                <p class="lyr__role">{l.role}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  {/* Sits outside .stack: inside it, the sticky stage is still in flow and
      this paragraph would render on top of the pinned layout. */}
  <section class="stack-out">
    <div class="wrap"><p class="stack__closing">{stack.closing}</p></div>
  </section>

  {/* ─────────────────── act three — durability ─────────────────── */}
  <section class="dura">
    <div class="wrap">
      <p class="chapter"><span class="chapter__rule" aria-hidden="true"></span>{durability.chapter}<span class="chapter__ghost" aria-hidden="true">03</span></p>
      <h2 class="dura__h2 reveal">{durability.heading}</h2>
      <div class="dura__lede">
        {durability.body.map((p) => <p class="reveal">{p}</p>)}
      </div>

      <div class="wear">
        <div class="wear__card wear__card--label">
          <p class="wear__kind mono">{durability.mechanism.contrast[0].label}</p>
          <div class="wear__panel">
            <span class="wear__legend wear__legend--abrades">START</span>
            <span class="wear__ink mono">ink on the outside</span>
          </div>
          <p class="wear__note">{durability.mechanism.contrast[0].detail}</p>
        </div>

        <div class="wear__card wear__card--sub">
          <p class="wear__kind mono">{durability.mechanism.contrast[1].label}</p>
          <div class="wear__panel wear__panel--sub">
            <span class="wear__film" aria-hidden="true"></span>
            <span class="wear__legend">START</span>
            <span class="wear__ink mono">ink on the inside</span>
          </div>
          <p class="wear__note">{durability.mechanism.contrast[1].detail}</p>
        </div>
      </div>

      <div class="mech reveal">
        <h3 class="mech__h3">{durability.mechanism.heading}</h3>
        <p class="mech__p">{durability.mechanism.body}</p>
      </div>

      <ul class="figs">
        {durability.proof.map((f) => (
          <li class="fig">
            <span class="fig__v mono">{f.figure}<span class="fig__u">{f.unit}</span></span>
            <span class="fig__n">{f.note}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ─────────────────── act four — the choice ─────────────────── */}
  <section class="choice">
    <div class="wrap">
      <p class="chapter chapter--dark"><span class="chapter__rule" aria-hidden="true"></span>{choice.chapter}<span class="chapter__ghost" aria-hidden="true">04</span></p>
      <h2 class="choice__h2 reveal">{choice.heading}</h2>
      <p class="choice__body reveal">{choice.body}</p>

      <ul class="opts">
        {choice.options.map((o) => (
          <li class="opt">
            <a class="opt__link" href={`/${o.slug}/`}>
              <span class="opt__product mono">{o.product}</span>
              <h3 class="opt__name">{o.name}</h3>
              <p class="opt__when">{o.when}</p>
              <dl class="opt__specs">
                <div><dt>Force</dt><dd class="mono">{o.force}</dd></div>
                <div><dt>Life</dt><dd class="mono">{o.life}</dd></div>
              </dl>
              <span class="opt__more">Specifications →</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="choice__foot">{choice.footnote}</p>
    </div>
  </section>

  {/* ─────────────────── act five — the process ─────────────────── */}
  <section class="proc">
    <div class="proc__stage">
      <div class="wrap proc__top">
        <div class="proc__head">
          <p class="chapter chapter--dark"><span class="chapter__rule" aria-hidden="true"></span>{process.chapter}<span class="chapter__ghost" aria-hidden="true">05</span></p>
          <h2 class="proc__h2 reveal">{process.heading}</h2>
          <p class="proc__body reveal">{process.body}</p>

          {/* seven segments, filling in step with the track */}
          <ol class="gauge" aria-hidden="true">
            {process.steps.map((st) => (
              <li class="gauge__seg"><span class="gauge__fill"></span><span class="gauge__n mono">{st.n}</span></li>
            ))}
          </ol>
        </div>

        <figure class="proc__piece">
          <WorkPiece />
          <figcaption class="proc__piececap mono"><span class="cap-rest">The finished panel</span><span class="cap-build">The panel, built as you scroll</span></figcaption>
        </figure>
      </div>

      <div class="proc__viewport">
        <ol class="steps">
          <span class="steps__line" aria-hidden="true"><span class="steps__fill"></span></span>
          {process.steps.map((s, si) => (
            <li class="step" style={`--r: cover ${25 + si * 7}% cover ${32 + si * 7}%`}>
              <div class="step__media">
                {s.photo ? (
                  <Image src={stepPhotos[s.photo]} alt={s.alt} width={680} height={425} loading="lazy" widths={[260, 400, 680]} sizes="(max-width: 860px) 140px, 340px" />
                ) : (
                  <StepArt kind={s.art} />
                )}
                <span class="step__n mono">{s.n}</span>
              </div>
              <div class="step__text">
                <p class="step__tag mono">{s.tag}</p>
                <h3 class="step__name">{s.name}</h3>
                <p class="step__detail">{s.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  {/* ─────────────────── act six — the proof ─────────────────── */}
  <section class="proof">
    <div class="wrap">
      <p class="chapter"><span class="chapter__rule" aria-hidden="true"></span>{proof.chapter}<span class="chapter__ghost" aria-hidden="true">06</span></p>
      <h2 class="proof__h2 reveal">{proof.heading}</h2>
      <p class="proof__body reveal">{proof.body}</p>

      <ul class="inds">
        {industries.map((ind) => (
          <li class="ind">
            <h3 class="ind__name">{ind.name}</h3>
            <p class="ind__demand">{ind.demand}</p>
            <a class="ind__link" href={`/${ind.typical}/`}>{ind.typicalLabel}</a>
          </li>
        ))}
      </ul>

      <div class="tally">
        {site.stats.map((s) => (
          <div class="tally__i">
            <span class="tally__clip"><span class="tally__v mono">{s.value}</span></span>
            <span class="tally__rule" aria-hidden="true"></span>
            <span class="tally__l">{s.label}</span>
          </div>
        ))}
        <div class="tally__i tally__i--cert">
          <span class="tally__v tally__v--sm">{cert.standard}</span>
          <span class="tally__l">Certificate <span class="mono">{cert.number}</span>, valid to 15 December 2028</span>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* ════════════════════════════════════════════════════════════
     BASE — everything below is the at-rest page. It is complete
     and readable on its own; the @supports block at the bottom
     adds the scroll choreography on top of it.
     ════════════════════════════════════════════════════════════ */

  :where(.open, .act1, .stack, .dura, .choice, .proc, .proof) {
    --d1: clamp(42px, 8.4vw, 104px);   /* the opening only */
    --d2: clamp(31px, 5.4vw, 64px);    /* chapter titles */
  }

  .chapter {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--accent-ink);
    margin: 0 0 18px;
  }
  .chapter--dark { color: var(--accent); }
  .chapter__rule { display: block; width: 48px; height: 2px; background: currentColor; flex: none; }

  /* The numeral sits behind the heading at display scale — the device that
     tells you where you are in the story without another line of copy. */
  .chapter__ghost {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-46%);
    font-family: var(--font-display);
    font-size: clamp(86px, 13vw, 190px);
    font-weight: 700;
    letter-spacing: -.05em;
    line-height: 1;
    pointer-events: none;
    z-index: 0;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(36, 28, 22,.10);
  }
  .chapter--dark .chapter__ghost { -webkit-text-stroke-color: rgba(255,255,255,.12); }

  .rail { position: fixed; inset: 0 0 auto; height: 3px; z-index: 60; pointer-events: none; }
  .rail__fill { display: block; height: 100%; width: 100%; background: var(--accent); transform: scaleX(0); transform-origin: 0 50%; }

  /* Fine grain over the dark bands — stops large flat areas reading as
     plastic. Tiny SVG turbulence, no network request, no paint cost worth
     measuring at 3.5% opacity. */
  /* Grain as an extra background layer, not an overlay element.
     It was a positioned ::before, which needed `.stack > * { position: relative }`
     to lift the content above it — and Astro scopes that selector to
     `.stack[cid] > [cid]`, which outranks `.stack__stage[cid]` and silently
     replaced `position: sticky` with `relative`. That killed the pin on the
     whole exploded-stack section. A background layer needs no z-index at all. */
  .stack, .choice, .stack-out, .open { position: relative; }
  :where(.stack, .choice, .stack-out, .open) {
    background-image: var(--grain);
  }
  .stack { background-color: var(--ink); }
  .choice { background-color: var(--ink); }
  .stack-out { background-color: var(--ink); }

  /* ───────── opening ───────── */
  .open { position: relative; overflow: clip; }
  /* Circuit field behind the opening — the slowest parallax plane. */
  .open__field {
    position: absolute;
    inset: -12% -4%;
    pointer-events: none;
    z-index: 0;
    opacity: .85;
    background-image:
      repeating-linear-gradient(90deg, rgba(255,255,255,.055) 0 1px, transparent 1px 76px),
      repeating-linear-gradient(0deg,  rgba(255,255,255,.04)  0 1px, transparent 1px 76px),
      radial-gradient(circle at 18% 22%, rgba(240, 136, 32,.30) 0 5px, transparent 6px),
      radial-gradient(circle at 76% 34%, rgba(240, 136, 32,.22) 0 4px, transparent 5px),
      radial-gradient(circle at 42% 78%, rgba(240, 136, 32,.18) 0 4px, transparent 5px),
      radial-gradient(circle at 88% 74%, rgba(255,255,255,.10) 0 3px, transparent 4px);
    -webkit-mask-image: radial-gradient(120% 90% at 50% 40%, #000 35%, transparent 78%);
    mask-image: radial-gradient(120% 90% at 50% 40%, #000 35%, transparent 78%);
  }
  .open__grid { position: relative; z-index: 1; }

  .open {
    /* Runs straight out of the graphite header rather than cutting to white.
       A layered ground, not a flat fill — flat near-black reads as plastic. */
    background-color: var(--ink);
    background-image:
      var(--grain),
      radial-gradient(112% 128% at 76% -8%, #2E251E 0%, #241C16 42%, var(--ink) 74%);
    color: #D6C9B9;
    padding-block: clamp(52px, 7vw, 104px) clamp(56px, 7vw, 104px);
  }
  .open__h1 { color: #fff; }
  /* the ghost button is drawn for light grounds; restate it for this one */
  .open .btn--ghost { color: #fff; border-color: rgba(255,255,255,.34); background: transparent; }
  .open .btn--ghost:hover { border-color: #fff; background: rgba(255,255,255,.08); }
  .open .eyebrow { color: var(--accent); }
  .open__grid {
    display: grid;
    grid-template-columns: 1.08fr .92fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    min-height: min(70svh, 620px);
  }
  .open__h1 {
    font-size: var(--d1);
    font-weight: 700;
    letter-spacing: -0.032em;
    line-height: .95;
    margin-top: 18px;
    max-width: 15ch;
  }
  .open__lede {
    max-width: 54ch;
    margin-top: 20px;
    font-size: clamp(17px, 1.7vw, 20px);
    color: #C2B2A0;            /* was --ink-soft: dark text on the dark ground */
  }
  .open__actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 30px; }
  .open__cue {
    display: flex; align-items: center; gap: 12px;
    margin-top: 34px;
    font-family: var(--font-mono);
    font-size: 11.5px; letter-spacing: .14em; text-transform: uppercase;
    color: #AB9887;            /* was --muted: too dark on the dark ground */
  }
  .open__cueline { display: block; width: 46px; height: 1px; background: var(--accent); }
  .open__media {
    display: grid;
    place-items: center;
    position: relative;
  }
  /* a pool of light under the parts instead of a bordered box */
  .open__media::before {
    content: '';
    position: absolute;
    inset: 4% -10% -6% -10%;
    background: radial-gradient(58% 54% at 50% 48%, rgba(240, 136, 32,.20) 0%, rgba(240, 136, 32,0) 70%);
    pointer-events: none;
  }
  .open__media :global(img) {
    position: relative;
    width: 116%;
    max-width: none;
    height: auto;
    filter: drop-shadow(0 34px 44px rgba(0,0,0,.55));
  }

  /* ───────── act one ───────── */
  .act1 { background: var(--ground); padding-block: clamp(64px, 9vw, 128px); }
  .act1__grid { display: grid; grid-template-columns: minmax(0, 1fr); }
  .act1__h2 { position: relative; z-index: 1; font-size: var(--d2); letter-spacing: -.026em; line-height: 1.02; max-width: 20ch; }
  .act1__p { position: relative; z-index: 1; max-width: 60ch; margin-top: 20px; font-size: clamp(17px, 1.6vw, 19px); color: var(--ink-soft); }
  /* The wrapper stays `inline` — as an inline-block it trims its own trailing
     whitespace and the quote renders as one unbroken word. Only the inner
     span needs to be a block for the transform. */
  .pull__w { display: inline; }
  .pull__i { display: inline-block; }
  .act1__pull { position: relative; z-index: 1;
    margin-top: 34px; padding-left: 20px;
    border-left: 3px solid var(--accent);
    font-family: var(--font-display);
    font-size: clamp(22px, 3vw, 32px);
    font-weight: 600;
    color: var(--ink);
    max-width: 22ch;
  }

  /* ───────── act two — the stack ───────── */
  .stack { color: #E4DACE; padding-block: clamp(64px, 9vw, 120px); }
  .stack__grid { display: grid; gap: clamp(28px, 4vw, 44px); }
  .stack__intro { max-width: 60ch; }
  .stack__h2 { position: relative; z-index: 1; font-size: var(--d2); letter-spacing: -.026em; line-height: 1.02; color: #fff; margin-top: 4px; }
  .stack__body { position: relative; z-index: 1; margin-top: 16px; font-size: clamp(17px, 1.6vw, 19px); color: #D6C9B9; }

  /* The 3D scene is decorative and desktop-only; it stays out of the document
     until the choreography block below turns it on. */
  .stack__viz { display: none; }
  .stack__scene { position: relative; width: 100%; height: 100%; transform: translateZ(0); }

  /* Each sheet is drawn, not photographed — the real layers are 0.175 mm of
     polyester and would photograph as a grey rectangle. Treatments below say
     what each one is: printed face, tacky adhesive, silver traces, cut spacer. */
  /* Sheet artwork now lives in LayerArt.astro — one shared viewBox, so the
     key positions, the display window and the tail register through all six
     layers. The sheet element only supplies the 3D placement. */

  .stack-out { padding-block: clamp(24px, 3vw, 40px) clamp(56px, 8vw, 96px); }

  .stack__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; background: rgba(255,255,255,.13); border: 1px solid rgba(255,255,255,.13); border-radius: var(--radius); overflow: hidden; }
  .lyr { background: var(--ink); display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 16px; padding: 18px 20px; }
  .lyr__n { color: var(--accent); font-size: 13px; font-weight: 500; padding-top: 3px; }
  .lyr__name { font-size: 19px; font-weight: 600; color: #fff; }
  .lyr__spec { font-size: 12.5px; color: #AB9887; margin-top: 3px; }
  .lyr__role { font-size: 15px; color: #D6C9B9; margin-top: 8px; max-width: 56ch; }

  .stack__closing {
    display: block;
    margin-top: 0;
    font-size: clamp(16px, 1.6vw, 18px);
    color: #AB9887;
    max-width: 62ch;
  }

  /* ───────── act three — durability ───────── */
  .dura { background: var(--surface); padding-block: clamp(64px, 9vw, 128px); }
  .dura__h2 { position: relative; z-index: 1; font-size: var(--d2); letter-spacing: -.026em; line-height: 1.02; max-width: 18ch; }
  .dura__lede { position: relative; z-index: 1; margin-top: 20px; display: grid; gap: 16px; }
  .dura__lede p { max-width: 60ch; font-size: clamp(17px, 1.6vw, 19px); color: var(--ink-soft); }

  .wear { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; margin-top: clamp(34px, 4vw, 52px); }
  .wear__card { border: 1px solid var(--line); border-radius: var(--radius); padding: 20px; background: var(--ground); }
  .wear__kind { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .wear__panel {
    position: relative;
    height: 128px;
    margin: 14px 0 16px;
    border-radius: 2px;
    /* Explicit colour under the gradient: a gradient alone leaves the computed
       background-color transparent, which breaks contrast tooling and leaves
       nothing behind the text if the gradient ever fails to paint. */
    background-color: #2E251E;
    background-image: linear-gradient(170deg, #3B3028, #1B140F);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .wear__legend {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 700;
    letter-spacing: .1em;
    color: #F7F3ED;
  }
  .wear__ink { position: absolute; bottom: 8px; left: 10px; font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; color: #AB9887; }
  .wear__film {
    position: absolute; inset: 0;
    background: linear-gradient(150deg, rgba(255,255,255,.16), rgba(255,255,255,.02) 42%, rgba(255,255,255,.10));
    border-bottom: 1px solid rgba(255,255,255,.14);
    pointer-events: none;
  }
  .wear__note { font-size: 14.6px; color: var(--ink-soft); line-height: 1.55; }

  .mech {
    margin-top: clamp(30px, 4vw, 46px);
    border-left: 3px solid var(--accent);
    padding: 4px 0 4px 22px;
  }
  .mech__h3 { font-size: clamp(21px, 2.6vw, 28px); font-weight: 600; max-width: 22ch; }
  .mech__p { margin-top: 12px; max-width: 62ch; font-size: 17px; color: var(--ink-soft); }

  .figs {
    list-style: none;
    margin: clamp(40px, 5vw, 64px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: clamp(26px, 3.5vw, 52px);
  }
  .fig {
    padding-left: 20px;
    border-left: 2px solid var(--accent);
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .fig__v { font-family: var(--font-display); font-size: clamp(38px, 5.2vw, 66px); font-weight: 700; line-height: .92; letter-spacing: -.035em; display: flex; align-items: baseline; gap: 9px; flex-wrap: wrap; }
  .fig__u { font-family: var(--font-mono); font-size: 13px; font-weight: 400; color: var(--muted); letter-spacing: 0; }
  .fig__n { font-size: 14.4px; color: var(--muted); line-height: 1.45; }

  /* ───────── act four — the choice ───────── */
  .choice { color: #E4DACE; padding-block: clamp(64px, 9vw, 128px); }
  .choice__h2 { position: relative; z-index: 1; font-size: var(--d2); letter-spacing: -.026em; line-height: 1.02; color: #fff; max-width: 20ch; }
  .choice__body { position: relative; z-index: 1; margin-top: 18px; max-width: 60ch; font-size: clamp(17px, 1.6vw, 19px); color: #D6C9B9; }

  .opts { list-style: none; margin: clamp(34px, 4vw, 52px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px; }
  .opt { border: 1px solid rgba(255,255,255,.16); border-radius: var(--radius); background: #241C16; transition: border-color .18s ease, transform .18s ease; }
  .opt:hover { border-color: var(--accent); }
  .opt__link { display: flex; flex-direction: column; gap: 10px; height: 100%; padding: 22px; text-decoration: none; color: inherit; }
  .opt__product { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); }
  .opt__name { font-size: 25px; font-weight: 600; color: #fff; }
  .opt__when { font-size: 15px; color: #D6C9B9; line-height: 1.55; }
  .opt__specs { margin: 6px 0 0; display: flex; gap: 26px; border-top: 1px solid rgba(255,255,255,.14); padding-top: 13px; }
  .opt__specs dt { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: #AB9887; }
  .opt__specs dd { margin: 3px 0 0; font-size: 14.5px; color: #fff; }
  .opt__more { margin-top: auto; padding-top: 14px; font-size: 14.5px; font-weight: 600; color: var(--accent); }
  .choice__foot { margin-top: 24px; font-size: 16px; color: #AB9887; max-width: 58ch; }

  /* ───────── act five — the process ───────── */
  /* Chapter five is the workshop chapter, so it gets a bench rather than the
     flat page ground: deep graphite, a faint setting-out grid, and a warm pool
     of light where the part sits. It also makes the factory photographs read
     far better than they do on white. */
  .proc {
    background-color: #1B140F;
    background-image:
      var(--grain),
      radial-gradient(52% 46% at 74% 30%, rgba(240, 136, 32,.16) 0%, rgba(240, 136, 32,0) 68%),
      repeating-linear-gradient(90deg, rgba(255,255,255,.035) 0 1px, transparent 1px 64px),
      repeating-linear-gradient(0deg,  rgba(255,255,255,.028) 0 1px, transparent 1px 64px),
      linear-gradient(180deg, #1B140F 0%, #1B140F 46%, #120C09 100%);
    color: #D6C9B9;
    padding-block: clamp(64px, 9vw, 128px);
    position: relative;
  }
  .proc__h2 { color: #fff; }
  .proc__viewport { position: relative; }
  .proc__top { display: grid; gap: clamp(24px, 4vw, 48px); }
  .proc__piece {
    margin: 0;
    position: relative;
    /* without the pinned two-column layout this would run the full page width */
    max-width: 460px;
    margin-inline: auto;
    padding: clamp(18px, 3vw, 30px) clamp(18px, 3vw, 30px) 14px;
  }
  /* pool of lamp light under the part */
  .proc__piece::before {
    content: '';
    position: absolute;
    inset: -6% -2% -2%;
    background: radial-gradient(52% 48% at 50% 46%, rgba(255, 238, 214,.14) 0%, rgba(255, 238, 214,0) 72%);
    pointer-events: none;
  }
  .proc__piece :global(svg) { position: relative; filter: drop-shadow(0 22px 26px rgba(0,0,0,.6)); }
  .cap-build { display: none; }
  .proc__piececap {
    position: relative;
    margin-top: 14px;
    font-size: 10.5px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: #93806F;
    text-align: center;
  }
  /* The gauge is a scroll read-out; with no scroll timeline it says nothing. */
  .gauge { display: none; }
  .gauge__seg { position: relative; list-style: none; }
  .proc__h2 { position: relative; z-index: 1; font-size: var(--d2); letter-spacing: -.026em; line-height: 1.02; max-width: 20ch; }
  .proc__body { position: relative; z-index: 1; margin-top: 18px; max-width: 60ch; font-size: clamp(17px, 1.6vw, 19px); color: #C2B2A0; }

  .steps { position: relative; list-style: none; margin: clamp(34px, 4vw, 52px) 0 0; padding: 0; display: grid; gap: 2px; }
  .steps__line { position: absolute; left: 65px; top: 10px; bottom: 10px; width: 2px; background: rgba(255,255,255,.16); }
  .steps__fill { display: block; width: 100%; height: 100%; background: var(--accent); transform: scaleY(1); transform-origin: 50% 0; }
  .step { position: relative; display: grid; grid-template-columns: 132px minmax(0, 1fr); gap: 20px; padding: 18px 0; align-items: start; }
  .step__media {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    overflow: hidden;
    background: #120C09;
    border: 1px solid rgba(255,255,255,.14);
  }
  .step__media :global(img),
  .step__media :global(svg) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .step__n {
    position: absolute;
    left: 8px; bottom: 8px;
    z-index: 1;
    display: grid; place-items: center;
    min-width: 28px; height: 24px;
    padding-inline: 7px;
    border-radius: 2px;
    background: var(--accent);
    color: var(--ink);
    font-size: 12px; font-weight: 600;
    letter-spacing: .04em;
  }
  .step__tag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: .13em;
    text-transform: uppercase;
    color: #FFA24D;
    margin-bottom: 6px;
  }
  .step__name { font-size: 20px; font-weight: 600; color: #fff; }
  .step__detail { margin-top: 7px; font-size: 15.6px; color: #C2B2A0; max-width: 62ch; line-height: 1.55; }

  /* ───────── act six — proof ───────── */
  .proof { background: var(--surface); padding-block: clamp(64px, 9vw, 128px); }
  .proof__h2 { position: relative; z-index: 1; font-size: var(--d2); letter-spacing: -.026em; line-height: 1.02; }
  .proof__body { position: relative; z-index: 1; margin-top: 18px; max-width: 60ch; font-size: clamp(17px, 1.6vw, 19px); color: var(--ink-soft); }

  .inds {
    list-style: none;
    margin: clamp(34px, 4vw, 56px) 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .ind {
    display: grid;
    grid-template-columns: minmax(180px, 1fr) minmax(0, 2.1fr) minmax(140px, auto);
    gap: 10px clamp(20px, 3vw, 48px);
    align-items: baseline;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
    transition: background-color .18s ease, padding-inline .18s ease;
  }
  .ind:hover { background: var(--surface); padding-inline: 16px; }
  .ind__name {
    font-size: clamp(19px, 2vw, 25px);
    font-weight: 600;
    letter-spacing: -.012em;
  }
  .ind__demand { font-size: 15.2px; color: var(--muted); line-height: 1.55; }
  .ind__link {
    justify-self: end;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: .1em;
    text-transform: uppercase;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    min-height: 26px;
    padding-block: 5px;
  }
  .ind__link:hover { text-decoration: underline; }
  @media (max-width: 760px) {
    .ind { grid-template-columns: 1fr; }
    .ind__link { justify-self: start; }
  }

  /* Left as the only boxed thing on the page once the lists were de-carded,
     this row read as an orphan. The rule under each figure is enough. */
  .tally {
    margin-top: clamp(40px, 5vw, 64px);
    padding-top: clamp(28px, 3.5vw, 44px);
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: clamp(22px, 3vw, 44px);
  }
  .tally__i { display: flex; flex-direction: column; gap: 6px; }
  .tally__clip { display: block; overflow: hidden; }
  .tally__v { display: block; font-family: var(--font-display); font-size: 32px; font-weight: 700; line-height: 1.08; letter-spacing: -.02em; }
  .tally__rule { display: block; height: 2px; background: var(--accent); transform-origin: left center; margin: 4px 0 2px; }
  .tally__v--sm { font-size: 23px; color: var(--accent-ink); }
  .tally__l { font-size: 14.2px; color: var(--muted); line-height: 1.45; }
  /* the certificate is the one figure worth marking out */
  .tally__i--cert { padding-left: 18px; border-left: 3px solid var(--accent); }

  /* ───────── responsive ───────── */
  @media (max-width: 900px) {
    .open__grid { grid-template-columns: 1fr; min-height: 0; }
    /* the overhang is a nice device on a wide screen, but at phone width it
       was slicing the left-hand keypad in half */
    .open__media :global(img) { width: 100%; }
    .open__h1 { max-width: none; }
  }

  /* ════════════════════════════════════════════════════════════
     SCROLL CHOREOGRAPHY
     Added only where scroll timelines exist and motion is welcome.
     ════════════════════════════════════════════════════════════ */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {

      /* progress rail */
      .rail__fill {
        animation: rail-grow linear both;
        animation-timeline: scroll(root block);
      }
      @keyframes rail-grow { to { transform: scaleX(1); } }

      /* generic reveal for headings and paragraphs */
      .reveal {
        animation: reveal-up var(--ease-out) both;
        animation-timeline: view();
        animation-range: cover 2% cover 30%;
        will-change: transform, opacity;
      }
      @keyframes reveal-up {
        from { opacity: 0; transform: translate3d(0, 16px, 0); }
        to   { opacity: 1; transform: translate3d(0, 0, 0); }
      }

      /* ── the opening settles as you leave it ── */
      .open__grid {
        animation: open-settle var(--ease-in-out) both;
        animation-timeline: view();
        animation-range: exit 10% exit 100%;
      }
      @keyframes open-settle {
        to { opacity: .42; transform: translate3d(0, -18px, 0); }
      }

      /* Hero art drifts a little slower than the page. Transform only. */
      .open__media {
        animation: hero-drift linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
      @keyframes hero-drift {
        from { transform: translate3d(0, -14px, 0); }
        to   { transform: translate3d(0, 26px, 0); }
      }

      /* Three planes moving at different rates through the opening: the
         circuit field slowest, the art in the middle, the copy barely at all.
         That difference in rate is the whole parallax effect. */
      .open__field {
        animation: field-drift linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
        will-change: transform;
      }
      @keyframes field-drift {
        from { transform: translate3d(0, -40px, 0) scale(1.06); }
        to   { transform: translate3d(0, 70px, 0)  scale(1.06); }
      }
      .open__copy {
        animation: copy-drift linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
      @keyframes copy-drift {
        from { transform: translate3d(0, -4px, 0); }
        to   { transform: translate3d(0, 10px, 0); }
      }

      /* ── pull quote, word by word ── */
      .pull__i {
        animation: word-in var(--ease-out) both;
        animation-timeline: view();
        will-change: transform, opacity;
      }
      @keyframes word-in {
        from { opacity: 0; transform: translate3d(0, 90%, 0) rotate(3deg); }
        to   { opacity: 1; transform: translate3d(0, 0, 0) rotate(0); }
      }
      .pull__w:nth-child(1) .pull__i { animation-range: cover 18% cover 36%; }
      .pull__w:nth-child(2) .pull__i { animation-range: cover 22% cover 40%; }
      .pull__w:nth-child(3) .pull__i { animation-range: cover 26% cover 44%; }
      .pull__w:nth-child(4) .pull__i { animation-range: cover 30% cover 48%; }
      .pull__w:nth-child(5) .pull__i { animation-range: cover 34% cover 52%; }
      .pull__w:nth-child(6) .pull__i { animation-range: cover 38% cover 56%; }
      .pull__w:nth-child(7) .pull__i { animation-range: cover 42% cover 60%; }
      .pull__w:nth-child(n+8) .pull__i { animation-range: cover 46% cover 64%; }

      /* ── tally figures wipe up behind their own rule ── */
      .tally__v {
        animation: fig-wipe var(--ease-out) both;
        animation-timeline: view();
        animation-range: cover 6% cover 34%;
      }
      @keyframes fig-wipe {
        from { transform: translate3d(0, 105%, 0); }
        to   { transform: translate3d(0, 0, 0); }
      }
      .tally__rule {
        animation: rule-draw var(--ease-out) both;
        animation-timeline: view();
        animation-range: cover 10% cover 42%;
      }
      @keyframes rule-draw {
        from { transform: scaleX(0); }
        to   { transform: scaleX(1); }
      }

      .open__cueline {
        transform-origin: left center;
        animation: cue-pulse 1.9s ease-in-out infinite alternate;
        animation-timeline: auto;
        will-change: transform;
      }
      @keyframes cue-pulse { to { transform: scaleX(1.65); } }

      /* ── the exploded stack (desktop only) ── */
      @media (min-width: 860px) {
        .stack {
          height: 340svh;
          padding-block: 0;
          view-timeline-name: --stack;
          view-timeline-axis: block;
          position: relative;
        }
        .stack__stage {
          position: sticky;
          top: 0;
          height: 100svh;
          display: grid;
          align-content: center;
          padding-top: 72px;      /* clears the sticky header */
          /* Eases the moment the section pins and unpins, which otherwise
             arrives as a hard cut. Held at full opacity across the middle. */
          animation: stage-in var(--ease-out) both;
          animation-timeline: --stack;
          animation-range: cover 4% cover 96%;
        }
        @keyframes stage-in {
          0%   { opacity: 0; transform: translate3d(0, 20px, 0); }
          20%  { opacity: 1; transform: translate3d(0, 0, 0); }
          86%  { opacity: 1; transform: translate3d(0, 0, 0); }
          100% { opacity: .25; transform: translate3d(0, -14px, 0); }
        }
        /* Compacted so the intro plus all six layers fit inside one pinned
           viewport — at the section's normal sizing the list overran the
           stage and the heading was clipped under the header. */
        .stack__h2 { font-size: clamp(26px, 2.7vw, 36px); }
        .stack__body { font-size: 16px; margin-top: 10px; }
        .lyr { padding: 11px 18px; gap: 14px; grid-template-columns: 34px minmax(0, 1fr); }
        .lyr__name { font-size: 16.5px; }
        .lyr__spec { font-size: 11.5px; }
        .lyr__role { font-size: 13.6px; margin-top: 5px; line-height: 1.45; }
        .lyr__n { font-size: 12px; }
        .stack__grid {
          grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr);
          grid-template-areas:
            'intro viz'
            'list  viz';
          align-content: center;
          align-items: start;
          gap: 22px clamp(28px, 4vw, 56px);
        }
        .stack__intro { grid-area: intro; }
        /* no room for the display numeral beside a 540px intro column */
        .stack .chapter__ghost { display: none; }
        .stack__list  { grid-area: list; }

        .stack__viz {
          grid-area: viz;
          display: block;
          align-self: center;
          height: min(60svh, 470px);
          perspective: 1400px;
          perspective-origin: 50% 38%;
        }

        /* Sheets are laid out in an isometric view and translate along their
           own normal, so the stack literally assembles downward. */
        .sheet {
          position: absolute;
          left: 50%; top: 50%;
          width: min(27vw, 320px);
          aspect-ratio: 300 / 210;
          margin: 0;
          transform-style: preserve-3d;
          border-radius: 4px;
          transform:
            translate(-50%, -50%)
            rotateX(60deg) rotateZ(-40deg)
            translateZ(calc(var(--k) * 36px));
          animation: sheet-assemble var(--ease-settle) both;
          animation-timeline: --stack;
          will-change: transform, opacity;
          backface-visibility: hidden;
        }
        @keyframes sheet-assemble {
          from {
            opacity: 0;
            transform:
              translate(-50%, -50%)
              rotateX(60deg) rotateZ(-40deg)
              translateZ(calc(var(--k) * 36px + 360px));
          }
          35% { opacity: 1; }
          to {
            opacity: 1;
            transform:
              translate(-50%, -50%)
              rotateX(60deg) rotateZ(-40deg)
              translateZ(calc(var(--k) * 36px));
          }
        }
        /* Explicit ranges rather than calc(var()) — wider engine support.
           Bottom sheet (rear adhesive, :nth-child(6)) lands first. */
        .sheet:nth-child(6) { animation-range: cover 25% cover 47%; }
        .sheet:nth-child(5) { animation-range: cover 31% cover 53%; }
        .sheet:nth-child(4) { animation-range: cover 36% cover 58%; }
        .sheet:nth-child(3) { animation-range: cover 42% cover 64%; }
        .sheet:nth-child(2) { animation-range: cover 47% cover 69%; }
        .sheet:nth-child(1) { animation-range: cover 53% cover 75%; }

        .lyr {
          animation: lyr-in var(--ease-out) both;
          animation-timeline: --stack;
          will-change: opacity, transform;
        }
        @keyframes lyr-in {
          from { opacity: .22; transform: translate3d(-8px, 0, 0); }
          to   { opacity: 1;   transform: translate3d(0, 0, 0); }
        }
        .lyr:nth-child(6) { animation-range: cover 25% cover 47%; }
        .lyr:nth-child(5) { animation-range: cover 31% cover 53%; }
        .lyr:nth-child(4) { animation-range: cover 36% cover 58%; }
        .lyr:nth-child(3) { animation-range: cover 42% cover 64%; }
        .lyr:nth-child(2) { animation-range: cover 47% cover 69%; }
        .lyr:nth-child(1) { animation-range: cover 53% cover 75%; }

      }

      /* ── abrasion: the printed label loses its legend, the overlay keeps it ── */
      .wear__legend--abrades {
        will-change: opacity, filter, transform;
        animation: abrade var(--ease-in-out) both;
        animation-timeline: view();
        animation-range: entry 40% cover 62%;
      }
      @keyframes abrade {
        from { opacity: 1; filter: blur(0);     transform: scale(1); }
        to   { opacity: .08; filter: blur(3px); transform: scale(1.06); }
      }
      .wear__card--label .wear__panel::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(112deg, transparent 42%, rgba(255,255,255,.13) 50%, transparent 58%);
        transform: translateX(-120%);
        animation: swipe linear both;
        animation-timeline: view();
        animation-range: entry 40% cover 62%;
      }
      @keyframes swipe { to { transform: translateX(120%); } }

      /* ── the process line draws itself ── */
      .steps__fill {
        transform: scaleY(0);
        animation: draw-line linear both;
        animation-timeline: view();
        animation-range: entry 30% exit 24%;
      }
      @keyframes draw-line { to { transform: scaleY(1); } }

      .step {
        animation: step-in var(--ease-out) both;
        animation-timeline: view();
        animation-range: cover 5% cover 36%;
      }

      /* ── the seven steps run sideways while the section is pinned ──
         A linear process read as a linear move. Desktop only: on a phone the
         default vertical timeline is the better read, and a horizontal track
         inside a pinned viewport is miserable on touch. */
      @media (min-width: 860px) {
        .proc {
          height: 420svh;
          padding-block: 0;
          position: relative;
          view-timeline-name: --proc;
          view-timeline-axis: block;
        }
        .proc__stage {
          position: sticky;
          top: 0;
          height: 100svh;
          display: grid;
          align-content: center;
          gap: clamp(24px, 3vw, 44px);
          padding-top: 72px;
          overflow: hidden;
        }
        .proc__top {
          display: grid;
          grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr);
          align-items: center;
          gap: clamp(28px, 4vw, 64px);
        }
        .proc__head { max-width: 46ch; }
        .proc__piece {
          background: transparent;
          border: 0;
          padding: 0;
          max-width: 386px;
          margin-inline: 0;
          justify-self: end;
          width: 100%;
        }
        .cap-rest { display: none; }
        .cap-build { display: inline; }
        .proc__piececap { text-align: right; margin-top: 10px; color: #93806F; }

        /* seven segments, one per step, filling with the track */
        .gauge {
          display: flex;
          gap: 6px;
          list-style: none;
          margin: 26px 0 0;
          padding: 0;
        }
        .gauge__seg {
          flex: 1;
          display: grid;
          gap: 6px;
          justify-items: start;
        }
        .gauge__fill {
          display: block;
          width: 100%;
          height: 4px;
          border-radius: 2px;
          background: rgba(255,255,255,.14);
          box-shadow: inset 0 1px 1px rgba(0,0,0,.5);
          position: relative;
          overflow: hidden;
        }
        .gauge__fill::after {
          content: '';
          position: absolute;
          inset: 0;
          background: linear-gradient(90deg, var(--accent), #FFA24D);
          box-shadow: 0 0 10px rgba(240, 136, 32,.65);
          transform: scaleX(0);
          transform-origin: left center;
        }
        .gauge__n {
          font-size: 10px;
          letter-spacing: .1em;
          color: #93806F;
        }
        .proc__h2 { font-size: clamp(28px, 3.4vw, 42px); }
        .proc__body { margin-top: 14px; font-size: 17px; }

        .proc__viewport {
          overflow: hidden;
          -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 5%, #000 95%, transparent 100%);
          mask-image: linear-gradient(90deg, transparent 0, #000 5%, #000 95%, transparent 100%);
        }

        .steps {
          display: flex;
          flex-direction: row;
          align-items: stretch;
          width: max-content;
          gap: 20px;
          padding-inline: var(--gutter);
          margin: 0;
          animation: track linear both;
          animation-timeline: --proc;
          animation-range: cover 24% cover 76%;
          will-change: transform;
        }
        @keyframes track {
          from { transform: translate3d(0, 0, 0); }
          /* The track's own padding-inline already supplies the trailing
             gutter; subtracting it again left a double margin at the end. */
          to { transform: translate3d(calc(-100% + 100vw), 0, 0); }
        }

        /* the vertical rail belongs to the stacked layout only */
        .steps__line { display: none; }

        .gauge__fill::after {
          animation: gauge-fill linear both;
          animation-timeline: --proc;
        }
        @keyframes gauge-fill { to { transform: scaleX(1); } }
        .gauge__seg:nth-child(1) .gauge__fill::after { animation-range: cover 25% cover 31%; }
        .gauge__seg:nth-child(2) .gauge__fill::after { animation-range: cover 32% cover 38%; }
        .gauge__seg:nth-child(3) .gauge__fill::after { animation-range: cover 39% cover 45%; }
        .gauge__seg:nth-child(4) .gauge__fill::after { animation-range: cover 46% cover 52%; }
        .gauge__seg:nth-child(5) .gauge__fill::after { animation-range: cover 53% cover 59%; }
        .gauge__seg:nth-child(6) .gauge__fill::after { animation-range: cover 60% cover 66%; }
        .gauge__seg:nth-child(7) .gauge__fill::after { animation-range: cover 67% cover 73%; }

        .gauge__n {
          animation: gauge-lit linear both;
          animation-timeline: --proc;
        }
        @keyframes gauge-lit { to { color: #FFA24D; } }
        .gauge__seg:nth-child(1) .gauge__n { animation-range: cover 25% cover 31%; }
        .gauge__seg:nth-child(2) .gauge__n { animation-range: cover 32% cover 38%; }
        .gauge__seg:nth-child(3) .gauge__n { animation-range: cover 39% cover 45%; }
        .gauge__seg:nth-child(4) .gauge__n { animation-range: cover 46% cover 52%; }
        .gauge__seg:nth-child(5) .gauge__n { animation-range: cover 53% cover 59%; }
        .gauge__seg:nth-child(6) .gauge__n { animation-range: cover 60% cover 66%; }
        .gauge__seg:nth-child(7) .gauge__n { animation-range: cover 67% cover 73%; }

        .step {
          width: 340px;
          flex: none;
          display: flex;
          flex-direction: column;
          gap: 0;
          padding: 0 0 18px;
          background: linear-gradient(180deg, #241C16 0%, #1B140F 100%);
          border: 1px solid rgba(255,255,255,.13);
          border-radius: var(--radius);
          overflow: hidden;
          box-shadow: 0 18px 34px -24px rgba(0,0,0,.9);
          position: relative;
          opacity: 1;
        }
        .step__media {
          aspect-ratio: 16 / 10;
          border: 0;
          border-bottom: 1px solid rgba(255,255,255,.13);
          border-radius: 0;
          width: 100%;
        }

        /* ── the card for the current step lifts, in lockstep with the gauge
           and the workpiece, so the three read as one instrument. Ranges match
           those in WorkPiece.astro exactly. Transform and opacity only. ── */
        .step {
          animation: step-lift linear both;
          animation-timeline: --proc;
          animation-range: var(--r);
          will-change: transform;
        }
        @keyframes step-lift {
          0%        { transform: translate3d(0, 0, 0); }
          20%, 80%  { transform: translate3d(0, -12px, 0); }
          100%      { transform: translate3d(0, 0, 0); }
        }
        .step::after {
          content: '';
          position: absolute;
          inset: 0;
          border: 1px solid var(--accent);
          border-radius: var(--radius);
          pointer-events: none;
          opacity: 0;
          animation: step-ring linear both;
          animation-timeline: --proc;
          animation-range: var(--r);
        }
        @keyframes step-ring {
          0%        { opacity: 0; }
          20%, 80%  { opacity: .85; }
          100%      { opacity: 0; }
        }

        /* the number chip lights with its card */
        .step__n {
          animation: chip-lit linear both;
          animation-timeline: --proc;
          animation-range: var(--r);
        }
        @keyframes chip-lit {
          0%        { opacity: .74; }
          20%, 80%  { opacity: 1; }
          100%      { opacity: .74; }
        }
        .step__n { left: 10px; bottom: 10px; height: 26px; font-size: 12.5px; }
        .step__text { padding: 15px 22px 0; }
        .step__name { font-size: 20px; }
        .step__detail { font-size: 15px; max-width: none; margin-top: 8px; }
      }
      @keyframes step-in {
        from { opacity: .3; transform: translate3d(-10px, 0, 0); }
        to   { opacity: 1; transform: translate3d(0, 0, 0); }
      }

      /* ── tiles rise as their row arrives ── */
      .fig, .opt, .ind, .tally__i {
        animation: tile-in var(--ease-out) both;
        animation-timeline: view();
        animation-range: cover 3% cover 32%;
      }
      @keyframes tile-in {
        from { opacity: 0; transform: translate3d(0, 14px, 0); }
        to   { opacity: 1; transform: translate3d(0, 0, 0); }
      }
    }
  }
</style>
