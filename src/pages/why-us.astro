---
/**
 * Why choose AFI.
 *
 * The old page carried seven benefit headings — "Unmatched Quality &
 * Durability", "Rapid Turnaround Times", "Proven Track Record" and four more —
 * with no body text under any of them. Same seven promises, each now saying
 * something specific enough to be held to.
 */
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';

const reasons = [
  {
    title: 'Quality and durability',
    claim: 'A panel should outlast the electronics behind it.',
    body: 'Sub-surface printing puts the legend under the film, where cleaning agents and fingernails cannot reach it. Non-tactile constructions take up to five million actuations; tactile panels take over a million and soften gradually rather than failing outright, so a keypad warns you before it dies.',
  },
  {
    title: 'Tailored to your needs',
    claim: 'Every panel is made for one piece of equipment.',
    body: 'We do not hold catalogue parts and try to talk you into the nearest one. Outline, key layout, dome force, emboss height, connector, colours and finish are all specified per job.',
  },
  {
    title: 'Innovation at every step',
    claim: 'The useful innovation is in the details that fail.',
    body: 'Dead-front windows with ink density matched to your LED. Gold-plated dome contacts where copper would oxidise. Artwork pre-compensated for emboss stretch. None of it is exotic; all of it is the difference between a panel that ages well and one that does not.',
  },
  {
    title: 'Competitive pricing',
    claim: 'Priced against the construction, not the postcode.',
    body: 'Because printing, tooling, forming and assembly are in-house, there is no subcontractor margin stacked into the quote and no coordination cost when a revision lands. We will also tell you when a cheaper construction would do the job — a non-tactile panel instead of domes, for instance.',
  },
  {
    title: 'Rapid turnaround',
    claim: 'Revisions do not restart the schedule.',
    body: 'The slow part of a keypad project is usually artwork approval, not manufacturing. Keeping every process in one building means a change to a legend or a die line is absorbed in days rather than passed between suppliers.',
  },
  {
    title: 'End-to-end support',
    claim: 'From drawing review to the harness behind the panel.',
    body: 'We review your drawing before quoting and raise what will not work. Keypad, overlay, rigid board and wire harness are all inside our certified scope, so one supplier owns the whole interface.',
  },
  {
    title: 'Proven track record',
    claim: `${site.yearsExperience} years, and an audited quality system.`,
    body: `Our panels are on medical, industrial, automotive, aviation and access-control equipment. The quality system behind them is certified to ${site.certification.standard} under ${site.certification.accreditation} accreditation, with scheduled surveillance audits — not a self-declaration.`,
  },
];
---

<Base
  title={`Why Choose AFI Technologies | ${site.name}`}
  description="Seven reasons equipment builders specify AFI Technologies for membrane keypads: durability, bespoke design, in-house manufacturing, fast revisions, end-to-end scope and an audited ISO 9001:2015 quality system."
  path="/why-us/"
  crumbLabel="Why us"
  breadcrumbs={[{ label: 'About', href: '/about-us/' }]}
>
  <PageHeader
    eyebrow="One stop solution"
    title="Why choose AFI Technologies"
    lede="Seven claims, each with something specific behind it. If any of them matters to your project, ask us to prove it before you place work."
    breadcrumbs={[{ label: 'About', href: '/about-us/' }]}
  />

  <section class="reasons">
    <div class="wrap">
      <ol class="reasons__list">
        {reasons.map((r, i) => (
          <li class="reason">
            <span class="reason__n mono">{String(i + 1).padStart(2, '0')}</span>
            <div class="reason__body">
              <h2 class="reason__title">{r.title}</h2>
              <p class="reason__claim">{r.claim}</p>
              <p class="reason__text">{r.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="ask">
    <div class="wrap ask__inner">
      <div>
        <p class="eyebrow eyebrow--on-dark">Worth asking any supplier</p>
        <h2 class="section-title ask__title">Four questions that separate suppliers</h2>
      </div>
      <ul class="ask__list">
        <li>Which of these processes do you subcontract, and to whom?</li>
        <li>What dome force are you quoting, and what is its rated life at that force?</li>
        <li>Is the legend printed on the surface or sub-surface?</li>
        <li>What happens to the tooling cost if I revise the artwork after first article?</li>
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .reasons { background: var(--surface); }
  .reasons__list { list-style: none; margin: 0; padding: 0; }
  .reason {
    display: grid; grid-template-columns: 56px 1fr; gap: 20px;
    padding: clamp(24px, 3vw, 38px) 0; border-top: 1px solid var(--line);
  }
  .reason:first-child { border-top: 0; padding-top: 0; }
  .reason__n { color: var(--accent-ink); font-size: 13px; padding-top: 8px; }
  .reason__title { font-size: clamp(23px, 2.8vw, 30px); }
  .reason__claim {
    margin-top: 8px; font-size: 18px; font-weight: 600; color: var(--accent-ink);
    max-width: 54ch;
  }
  .reason__text { margin-top: 12px; color: var(--ink-soft); font-size: 16.5px; max-width: 68ch; }

  .ask { background: var(--ink); color: #fff; }
  .ask__inner { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(28px, 4vw, 64px); align-items: start; }
  .ask__title { color: #fff; }
  .ask__list { list-style: none; margin: 0; padding: 0; }
  .ask__list li {
    padding: 16px 0 16px 30px; border-top: 1px solid #6B3115;
    color: #EECBA8; font-size: 17px; position: relative;
  }
  .ask__list li::before {
    content: '?'; position: absolute; left: 0; top: 16px;
    font-family: var(--font-mono); color: var(--accent); font-weight: 500;
  }

  @media (max-width: 820px) {
    .reason { grid-template-columns: 1fr; gap: 6px; }
    .reason__n { padding-top: 0; }
    .ask__inner { grid-template-columns: 1fr; }
  }
</style>
